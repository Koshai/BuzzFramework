<div class="buzz-empty-state">
    @if (!string.IsNullOrWhiteSpace(Icon))
    {
        <div class="buzz-empty-icon" aria-hidden="true">@Icon</div>
    }

    <h4 class="buzz-empty-title">@Title</h4>

    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p class="buzz-empty-description">@Description</p>
    }

    @if (PrimaryAction.HasDelegate)
    {
        <BuzzButton Text="@PrimaryActionText" Variant="primary" OnClick="PrimaryAction" />
    }
</div>

@code {
    [Parameter]
    public string Title { get; set; } = "No data yet";

    [Parameter]
    public string Description { get; set; } = "Start by adding your first item.";

    [Parameter]
    public string Icon { get; set; } = "o";

    [Parameter]
    public string PrimaryActionText { get; set; } = "Create item";

    [Parameter]
    public EventCallback PrimaryAction { get; set; }
}

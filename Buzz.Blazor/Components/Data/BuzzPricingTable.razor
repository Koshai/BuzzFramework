@using Buzz.Blazor.Models

<section class="buzz-pricing-table">
    <div class="buzz-pricing-grid">
        @foreach (var plan in Plans)
        {
            <article class="buzz-pricing-card @(plan.IsHighlighted ? "is-highlighted" : string.Empty)">
                <h3>@plan.Name</h3>
                <p class="buzz-pricing-price">@plan.Price <span>@plan.Period</span></p>
                <BuzzList Items="@plan.Features" Ordered="false" />
                <BuzzButton Text="@plan.CtaText"
                            Variant="@(plan.IsHighlighted ? "primary" : "outline")"
                            OnClick="() => SelectPlanAsync(plan)" />
            </article>
        }
    </div>
</section>

@code {
    /// <summary>
    /// Pricing plans displayed by the table.
    /// </summary>
    [Parameter]
    public IReadOnlyList<BuzzPricingPlan> Plans { get; set; } = Array.Empty<BuzzPricingPlan>();

    /// <summary>
    /// Callback invoked when a plan is selected.
    /// </summary>
    [Parameter]
    public EventCallback<BuzzPricingPlan> OnPlanSelected { get; set; }

    private Task SelectPlanAsync(BuzzPricingPlan plan) => OnPlanSelected.InvokeAsync(plan);
}

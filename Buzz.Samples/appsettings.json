{
  "Buzz": {
    "DefaultProvider": "openai",
    "ProviderFailoverOrder": [ "openai", "ollama", "mock" ],
    "EnableAiSuggestions": false,
    "AiMinInputLength": 12,
    "AiMaxLocalResultsBeforeSkip": 2,
    "AiCooldownSeconds": 10,
    "AiCacheTtlSeconds": 180,
    "EnableSharedCaseMemory": true,
    "SharedCaseMemoryMaxEntriesPerSubject": 2000,
    "EnableAiContextEnrichment": true,
    "EnableSeedKnowledgeBootstrap": true,
    "SeedKnowledgeFilePath": "seed/buzz-seed-knowledge.json",
    "SeedKnowledgeMaxMatchesPerRequest": 4,
    "UserMemoryMaxMatchesPerRequest": 5,
    "EnableSeedKnowledgeWarmupOnStartup": true,
    "OpenAI": {
      "Model": "gpt-4o-mini",
      "ApiKey": ""
    },
    "Ollama": {
      "BaseUrl": "http://localhost:11434/api/",
      "Model": "llama3.1:8b"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

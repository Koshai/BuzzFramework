@page "/textbox-demo"
@rendermode InteractiveServer

<PageTitle>BuzzTextBox Demo</PageTitle>

<h1>BuzzTextBox Demo: Support Reply Workflow</h1>

<p class="textbox-demo-intro">
    Scenario: a support agent writes repeated responses throughout the day.
    Press <strong>Enter</strong> after each final input so Buzz can remember it.
    Over time, each field should suggest better phrases while you type.
</p>

<div class="textbox-demo-grid">
    <section class="textbox-demo-panel">
        <h3>1) Issue Summary</h3>
        <BuzzTextBox
            Label="Issue Summary"
            @bind-InputText="_issueSummary"
            MemorySubject="@_sharedSubject"
            SuggestionCount="6"
            AddToHistoryOnEnter="true"
            AddToHistoryOnTab="true"
            Placeholder="Example: Login fails after password reset..." />
    </section>

    <section class="textbox-demo-panel">
        <h3>2) Resolution Notes</h3>
        <BuzzTextBox
            Label="Resolution Notes"
            @bind-InputText="_resolutionNotes"
            MemorySubject="@_sharedSubject"
            ReferenceText="@_issueSummary"
            SuggestionCount="6"
            AddToHistoryOnEnter="true"
            AddToHistoryOnTab="true"
            Placeholder="Example: Cleared stale session and reissued token..." />
    </section>

    <section class="textbox-demo-panel">
        <h3>3) Follow-up Message</h3>
        <BuzzTextBox
            Label="Follow-up Message"
            @bind-InputText="_followUpMessage"
            MemorySubject="@_sharedSubject"
            ReferenceText="@_issueSummary"
            SuggestionCount="6"
            AddToHistoryOnEnter="true"
            AddToHistoryOnTab="true"
            Placeholder="Example: Please confirm if you can access the account now..." />
    </section>

    <section class="textbox-demo-panel">
        <h3>4) Temporary Password (secure input)</h3>
        <BuzzTextBox
            Label="Temporary Password"
            @bind-InputText="_temporaryPassword"
            InputType="password"
            AddToHistoryOnEnter="false"
            AddToHistoryOnTab="false"
            EnableAiSuggestions="false"
            Placeholder="Password is masked and never suggested..." />
    </section>

    <section class="textbox-demo-panel">
        <h3>5) Resolution Category (BuzzComboBox)</h3>
        <BuzzComboBox
            Label="Resolution Category"
            @bind-Value="_resolutionCategory"
            MemorySubject="@_sharedSubject"
            ReferenceText="@_issueSummary"
            Options="@_resolutionCategories"
            MaxVisibleOptions="6"
            Placeholder="Select or type a category..." />
    </section>

    <section class="textbox-demo-panel">
        <h3>6) Escalation Level (BuzzSelectBox)</h3>
        <BuzzSelectBox
            Label="Escalation Level"
            @bind-Value="_escalationLevel"
            MemorySubject="@_sharedSubject"
            ReferenceText="@_issueSummary"
            Options="@_escalationLevels"
            MaxVisibleOptions="5"
            PlaceholderOptionText="Choose escalation level..."
            Required="true"
            HelperText="Pick the level used to route this ticket to the right queue."
            ErrorText="@_escalationLevelError"
            ShowRecommendationHint="true" />
        <button class="btn btn-sm btn-outline-primary mt-2" @onclick="ValidateEscalation">
            Validate Escalation Selection
        </button>
    </section>

    <section class="textbox-demo-panel">
        <h3>7) Require MFA Reset (BuzzCheckBox)</h3>
        <BuzzCheckBox
            Label="Require MFA reset on next login"
            @bind-Value="_requireMfaReset"
            MemorySubject="@_sharedSubject"
            ReferenceText="@_issueSummary"
            Required="true"
            HelperText="Enable this for compromised accounts or high-risk login anomalies."
            ErrorText="@_mfaResetError"
            ShowRecommendationHint="true" />
        <button class="btn btn-sm btn-outline-primary mt-2" @onclick="ValidateMfaReset">
            Validate MFA Reset Selection
        </button>
    </section>

    <section class="textbox-demo-panel">
        <h3>8) Case Summary (BuzzCard)</h3>
        <BuzzCard
            Title="Support Case Summary"
            Subtitle="Generated from current form state"
            SourceText="@CaseSummarySource"
            EnableAiSummary="true"
            ShowGenerateButton="true">
            <ChildContent>
                <p><strong>Issue:</strong> @_issueSummary</p>
                <p><strong>Category:</strong> @_resolutionCategory</p>
                <p><strong>Escalation:</strong> @_escalationLevel</p>
                <p><strong>Require MFA Reset:</strong> @_requireMfaReset</p>
            </ChildContent>
            <Actions>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CopySummarySeed">
                    Use Current State As Seed
                </button>
            </Actions>
        </BuzzCard>
    </section>
</div>

<div class="textbox-demo-current-values">
    <h3>Current form values</h3>
    <p><strong>Issue Summary:</strong> @_issueSummary</p>
    <p><strong>Resolution Notes:</strong> @_resolutionNotes</p>
    <p><strong>Follow-up Message:</strong> @_followUpMessage</p>
    <p><strong>Resolution Category:</strong> @_resolutionCategory</p>
    <p><strong>Escalation Level:</strong> @_escalationLevel</p>
    <p><strong>Require MFA Reset:</strong> @_requireMfaReset</p>
    <p><strong>Temporary Password Length:</strong> @_temporaryPassword.Length</p>
</div>

@code {
    private const string _sharedSubject = "support-login-cases";
    private string _issueSummary = string.Empty;
    private string _resolutionNotes = string.Empty;
    private string _followUpMessage = string.Empty;
    private string _resolutionCategory = string.Empty;
    private string _escalationLevel = string.Empty;
    private string? _escalationLevelError;
    private bool _requireMfaReset;
    private string? _mfaResetError;
    private string _temporaryPassword = string.Empty;
    private readonly IReadOnlyList<string> _resolutionCategories =
    [
        "Password reset flow",
        "Session/token refresh",
        "Multi-factor verification",
        "Account unlock",
        "Browser cache and cookies",
        "User role/permission fix",
        "Identity provider sync",
        "Network/VPN policy",
        "Frontend validation issue",
        "Backend auth service issue"
    ];
    private readonly IReadOnlyList<string> _escalationLevels =
    [
        "L1 - Self-service",
        "L2 - Support engineer",
        "L3 - Identity specialist",
        "L4 - Platform on-call",
        "Critical incident"
    ];

    private void ValidateEscalation()
    {
        _escalationLevelError = string.IsNullOrWhiteSpace(_escalationLevel)
            ? "Escalation Level is required for routing."
            : null;
    }

    private void ValidateMfaReset()
    {
        _mfaResetError = !_requireMfaReset
            ? "Set MFA reset when issue indicates account risk."
            : null;
    }

    private string CaseSummarySource =>
        $"Issue Summary: {_issueSummary}\n" +
        $"Resolution Notes: {_resolutionNotes}\n" +
        $"Follow-up Message: {_followUpMessage}\n" +
        $"Resolution Category: {_resolutionCategory}\n" +
        $"Escalation Level: {_escalationLevel}\n" +
        $"Require MFA Reset: {_requireMfaReset}";

    private void CopySummarySeed()
    {
        _followUpMessage = $"Case snapshot -> Category: {_resolutionCategory}, Escalation: {_escalationLevel}, MFA reset: {_requireMfaReset}.";
    }
}

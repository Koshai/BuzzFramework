@using Buzz.Blazor.Models
@using Buzz.Core
@using Microsoft.Extensions.Logging
@inject IBuzzClient BuzzClient
@inject ILogger<BuzzKanbanBoard> Logger

<div class="buzz-kanban">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <h3 class="buzz-kanban-label">@Label</h3>
    }

    @if (ShowRecommendationHint && !string.IsNullOrWhiteSpace(_recommendedColumn))
    {
        <p class="buzz-kanban-recommendation">
            Recommended focus lane: <strong>@_recommendedColumn</strong>
        </p>
    }

    <div class="buzz-kanban-grid">
        @foreach (var column in NormalizedColumns)
        {
            var cards = GetColumnItems(column);
            <section
                class="buzz-kanban-column @(_dragOverColumn == column ? "is-drop-target" : null)"
                @ondragover:preventDefault
                @ondragover="() => HandleDragOver(column)"
                @ondragleave="HandleDragLeave"
                @ondrop="() => HandleDropAsync(column)">
                <header class="buzz-kanban-column-header">
                    <span>@column</span>
                    @if (ShowCounts)
                    {
                        <span class="buzz-kanban-count">@cards.Count</span>
                    }
                </header>

                <div class="buzz-kanban-column-body">
                    @if (cards.Count == 0)
                    {
                        <p class="buzz-kanban-empty">No cards.</p>
                    }
                    else
                    {
                        @foreach (var item in cards)
                        {
                            <article
                                class="buzz-kanban-card buzz-kanban-card-@NormalizeSeverity(item.Severity)"
                                draggable="@EnableDragAndDrop"
                                @ondragstart="() => HandleDragStart(item.Id)"
                                @ondragend="HandleDragEnd">
                                <p class="buzz-kanban-card-title">@item.Title</p>
                                <p class="buzz-kanban-card-description">@item.Description</p>
                                @if (AllowMoveButtons)
                                {
                                    <div class="buzz-kanban-actions">
                                        <button
                                            type="button"
                                            class="buzz-kanban-button"
                                            disabled="@(!CanMoveLeft(item))"
                                            @onclick="() => MoveItemAsync(item, -1)">
                                            @MoveLeftButtonText
                                        </button>
                                        <button
                                            type="button"
                                            class="buzz-kanban-button"
                                            disabled="@(!CanMoveRight(item))"
                                            @onclick="() => MoveItemAsync(item, +1)">
                                            @MoveRightButtonText
                                        </button>
                                    </div>
                                }
                            </article>
                        }
                    }
                </div>
            </section>
        }
    </div>
</div>

@code {
    [Parameter]
    public string Label { get; set; } = "Buzz Kanban Board";

    [Parameter]
    public IReadOnlyList<string> Columns { get; set; } =
        ["Backlog", "In Progress", "Review", "Done"];

    [Parameter]
    public IReadOnlyList<BuzzKanbanItem> Items { get; set; } = [];

    [Parameter]
    public EventCallback<IReadOnlyList<BuzzKanbanItem>> ItemsChanged { get; set; }

    [Parameter]
    public EventCallback<BuzzKanbanMoveEvent> OnItemMoved { get; set; }

    [Parameter]
    public bool ShowCounts { get; set; } = true;

    [Parameter]
    public bool AllowMoveButtons { get; set; } = true;

    [Parameter]
    public string MoveLeftButtonText { get; set; } = "Move left";

    [Parameter]
    public string MoveRightButtonText { get; set; } = "Move right";

    [Parameter]
    public bool EnableDragAndDrop { get; set; } = true;

    [Parameter]
    public bool ShowRecommendationHint { get; set; } = true;

    [Parameter]
    public bool EnableAiRecommendedColumn { get; set; } = true;

    [Parameter]
    public bool AutoRecommendOnLoad { get; set; } = true;

    [Parameter]
    public string SourceText { get; set; } = string.Empty;

    [Parameter]
    public int MaxInputCharacters { get; set; } = 1400;

    private bool _recommendationLoaded;
    private string? _recommendedColumn;
    private string? _dragItemId;
    private string? _dragOverColumn;
    private List<BuzzKanbanItem> _items = [];

    private IReadOnlyList<string> NormalizedColumns =>
        Columns
            .Where(column => !string.IsNullOrWhiteSpace(column))
            .Select(column => column.Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

    protected override async Task OnParametersSetAsync()
    {
        _items = Items.ToList();

        if (!EnableAiRecommendedColumn || !AutoRecommendOnLoad || _recommendationLoaded || NormalizedColumns.Count == 0)
        {
            return;
        }

        await TryLoadRecommendationAsync();
        _recommendationLoaded = true;
    }

    private List<BuzzKanbanItem> GetColumnItems(string column) =>
        _items.Where(item => item.Column.Equals(column, StringComparison.OrdinalIgnoreCase)).ToList();

    private bool CanMoveLeft(BuzzKanbanItem item)
    {
        var index = GetColumnIndex(item.Column);
        return index > 0;
    }

    private bool CanMoveRight(BuzzKanbanItem item)
    {
        var index = GetColumnIndex(item.Column);
        return index >= 0 && index < NormalizedColumns.Count - 1;
    }

    private int GetColumnIndex(string column) =>
        NormalizedColumns
            .Select((name, index) => (name, index))
            .FirstOrDefault(entry => entry.name.Equals(column, StringComparison.OrdinalIgnoreCase))
            .index;

    private async Task MoveItemAsync(BuzzKanbanItem item, int direction)
    {
        var currentIndex = GetColumnIndex(item.Column);
        if (currentIndex < 0)
        {
            return;
        }

        var nextIndex = currentIndex + direction;
        if (nextIndex < 0 || nextIndex >= NormalizedColumns.Count)
        {
            return;
        }

        var targetColumn = NormalizedColumns[nextIndex];
        var updated = item with { Column = targetColumn };
        var replaceIndex = _items.FindIndex(entry => entry.Id.Equals(item.Id, StringComparison.OrdinalIgnoreCase));
        if (replaceIndex < 0)
        {
            return;
        }

        _items[replaceIndex] = updated;
        await ItemsChanged.InvokeAsync(_items.ToList());
        await OnItemMoved.InvokeAsync(new BuzzKanbanMoveEvent(item.Id, item.Column, targetColumn));
    }

    private void HandleDragStart(string itemId)
    {
        if (!EnableDragAndDrop)
        {
            return;
        }

        _dragItemId = itemId;
    }

    private void HandleDragOver(string column)
    {
        if (!EnableDragAndDrop)
        {
            return;
        }

        _dragOverColumn = column;
    }

    private void HandleDragLeave()
    {
        if (!EnableDragAndDrop)
        {
            return;
        }

        _dragOverColumn = null;
    }

    private void HandleDragEnd()
    {
        _dragItemId = null;
        _dragOverColumn = null;
    }

    private async Task HandleDropAsync(string column)
    {
        if (!EnableDragAndDrop || string.IsNullOrWhiteSpace(_dragItemId))
        {
            return;
        }

        var itemIndex = _items.FindIndex(item => item.Id.Equals(_dragItemId, StringComparison.OrdinalIgnoreCase));
        if (itemIndex < 0)
        {
            HandleDragEnd();
            return;
        }

        var current = _items[itemIndex];
        if (current.Column.Equals(column, StringComparison.OrdinalIgnoreCase))
        {
            HandleDragEnd();
            return;
        }

        _items[itemIndex] = current with { Column = column };
        await ItemsChanged.InvokeAsync(_items.ToList());
        await OnItemMoved.InvokeAsync(new BuzzKanbanMoveEvent(current.Id, current.Column, column));
        HandleDragEnd();
    }

    private async Task TryLoadRecommendationAsync()
    {
        var source = (SourceText ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(source))
        {
            return;
        }

        var constrainedInput = source.Length > MaxInputCharacters
            ? source[..MaxInputCharacters]
            : source;

        try
        {
            var response = await BuzzClient.GenerateAsync(
                new BuzzRequest(
                    constrainedInput,
                    "Choose exactly one best matching kanban lane from the provided list where the team should focus next. Return only the lane name.",
                    $"Lanes: {string.Join(" | ", NormalizedColumns)}"));

            var candidate = (response.OutputText ?? string.Empty).Trim();
            var match = NormalizedColumns.FirstOrDefault(column => column.Equals(candidate, StringComparison.OrdinalIgnoreCase))
                ?? NormalizedColumns.FirstOrDefault(column => candidate.Contains(column, StringComparison.OrdinalIgnoreCase));
            if (string.IsNullOrWhiteSpace(match))
            {
                return;
            }

            _recommendedColumn = match;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "BuzzKanbanBoard recommendation generation failed.");
        }
    }

    private static string NormalizeSeverity(string? severity)
    {
        if (string.IsNullOrWhiteSpace(severity))
        {
            return "info";
        }

        return severity.Trim().ToLowerInvariant() switch
        {
            "success" => "success",
            "warning" => "warning",
            "error" => "error",
            _ => "info"
        };
    }
}

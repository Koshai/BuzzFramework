@page "/tutorial-medical"
@page "/tutorial-todo"
@rendermode InteractiveServer
@using Buzz.Blazor.Models

<PageTitle>Medical Triage Tutorial - Buzz Framework</PageTitle>

<div class="medical-tutorial-page">
    <header class="medical-tutorial-hero">
        <BuzzBadge Text="Beginner Tutorial" Variant="info" />
        <h1>Build a Medical Triage Page with Buzz Components + AI</h1>
        <p>This guide is written for beginners. Follow each step in order, copy the snippets, then use the full final code block.</p>
    </header>

    <DemoAiContextBanner Title="Suggested AI Context"
                         Subtitle="Use this for components that support AI source/reference text."
                         SampleText="@_aiContextText" />

    <section class="medical-tutorial-card">
        <BuzzStepper Label="Step-by-step path"
                     Steps="@_steps"
                     AllowStepNavigation="true"
                     ShowRecommendationHint="false"
                     EnableAiRecommendedStep="true"
                     SourceText="@_aiContextText" />
    </section>

    <section class="medical-tutorial-grid">
        <article class="medical-tutorial-card">
            <h2>Step 1: Create your triage data model</h2>
            <p>Start with one record that tracks key triage fields.</p>
            <BuzzCodeBlock Code="@_modelSnippet" Language="csharp" ShowLineNumbers="false" EnableCopyButton="true" />
        </article>
        <article class="medical-tutorial-card">
            <h2>Step 2: Build a patient intake form</h2>
            <p>Use text, select, date, and checkbox controls for fast structured data entry.</p>
            <BuzzCodeBlock Code="@_intakeSnippet" Language="razor" ShowLineNumbers="false" EnableCopyButton="true" />
        </article>
    </section>

    <section class="medical-tutorial-grid">
        <article class="medical-tutorial-card">
            <h2>Step 3: Add workflow actions + risk banner</h2>
            <p>Use clear actions to add, seed, and clean up cases. Show warnings for high-risk conditions.</p>
            <BuzzCodeBlock Code="@_workflowSnippet" Language="razor" ShowLineNumbers="false" EnableCopyButton="true" />
        </article>
        <article class="medical-tutorial-card">
            <h2>Step 4: Add AI assistance components</h2>
            <p>Use <code>BuzzFormAssistant</code> for clinical note quality and <code>BuzzSmartTable</code> for triage analysis.</p>
            <BuzzCodeBlock Code="@_aiSnippet" Language="razor" ShowLineNumbers="false" EnableCopyButton="true" />
        </article>
    </section>

    <section class="medical-tutorial-grid">
        <article class="medical-tutorial-card">
            <h2>Step 5: Bootstrap seed context (important for first deployment)</h2>
            <p>Enable seed-first AI so suggestions are useful before enough user memory exists.</p>
            <BuzzCodeBlock Code="@_bootstrapSnippet" Language="json" ShowLineNumbers="false" EnableCopyButton="true" />
        </article>
        <article class="medical-tutorial-card">
            <h2>Step 6: Add a seed knowledge entry</h2>
            <p>Use a subject key like <code>medical-triage</code> so knowledge and live memory stay scoped.</p>
            <BuzzCodeBlock Code="@_seedSnippet" Language="json" ShowLineNumbers="false" EnableCopyButton="true" />
        </article>
    </section>

    <section class="medical-tutorial-card">
        <h2>Live Medical Triage Demo</h2>
        <p>Try the same flow you would build in your own project.</p>

        @if (HasCriticalCases)
        {
            <BuzzAlert Title="Critical Cases Detected"
                       Message="At least one active case is high risk. Review triage actions now."
                       Variant="warning"
                       Dismissible="false" />
        }

        <div class="medical-tutorial-form-grid">
            <BuzzTextBox Label="Patient Name"
                         Placeholder="Ex: John Doe"
                         InputText="@_patientName"
                         InputTextChanged="OnPatientNameChanged"
                         ReferenceText="@_aiContextText"
                         MemorySubject="medical-patient-name" />

            <BuzzTextBox Label="Primary Complaint"
                         Placeholder="Ex: Chest pain and dizziness"
                         InputText="@_complaint"
                         InputTextChanged="OnComplaintChanged"
                         ReferenceText="@_aiContextText"
                         MemorySubject="medical-complaint" />

            <BuzzSelectBox Label="Triage Severity"
                           Options="@_severityOptions"
                           Value="@_severity"
                           ValueChanged="OnSeverityChanged"
                           ReferenceText="@_aiContextText"
                           ShowRecommendationHint="true" />

            <BuzzDatePicker Label="Arrival Date"
                            Value="@_arrivalDate"
                            ValueChanged="OnArrivalDateChanged"
                            ReferenceText="@_aiContextText"
                            ShowQuickSuggestions="true" />

            <BuzzTextBox Label="SpO2 (%)"
                         Placeholder="Ex: 95"
                         InputText="@_spo2"
                         InputTextChanged="OnSpo2Changed"
                         MemorySubject="medical-vitals" />

            <BuzzCheckBox Label="Requires immediate physician review"
                          Value="@_needsImmediateReview"
                          ValueChanged="OnNeedsImmediateReviewChanged"
                          ShowRecommendationHint="false" />
        </div>

        <BuzzStack Direction="horizontal" Gap="0.45rem" Wrap="true" Align="center">
            <BuzzButton Text="Add Case" Variant="primary" OnClick="AddCaseAsync" Disabled="@string.IsNullOrWhiteSpace(_complaint)" />
            <BuzzButton Text="Seed Example Cases" Variant="outline" OnClick="SeedCasesAsync" />
            <BuzzButton Text="Clear Closed Cases" Variant="secondary" OnClick="ClearClosedCasesAsync" />
        </BuzzStack>

        <BuzzProgress Label="Active high-risk ratio"
                      Value="@HighRiskPercent"
                      Max="100"
                      Variant="danger"
                      ShowValueLabel="true" />

        <BuzzFormAssistant Label="Clinical Note Assistant"
                           Fields="@AssistantFields"
                           ShowChecklist="true"
                           ShowCompletionScore="true"
                           EnableAiRiskInsight="true"
                           AutoGenerateRiskInsightOnLoad="false"
                           EnableAiRewriteForMessage="true"
                           ShowGenerateButtons="true"
                           MessageDraft="@_handoverDraft"
                           MessageDraftChanged="OnHandoverDraftChanged"
                           RewriteInstruction="Rewrite this clinical handover to be concise, neutral, and action-oriented."
                           AiContextSubject="medical-triage"
                           SourceText="@_aiContextText"
                           MaxInputCharacters="1800" />

        <BuzzSmartTable Label="Live Triage Board"
                        Columns="@_tableColumns"
                        Rows="@TableRows"
                        Modules="@BuzzSmartTableModules.Analytics"
                        ShowSummaryFooter="true"
                        ShowInsightsPanel="true"
                        ShowAiInsightsPanel="true"
                        ShowFilterPanel="true"
                        EnableGlobalSearch="true"
                        EnableGrouping="true"
                        ShowRecommendationHint="true"
                        EnableAiRecommendedSort="true"
                        AutoRecommendSortOnLoad="true"
                        EnableAiInsights="true"
                        AutoGenerateAiInsightsOnLoad="true"
                        AiContextSubject="medical-triage"
                        SourceText="@_aiContextText"
                        MaxInputCharacters="1400" />
    </section>

    <section class="medical-tutorial-card">
        <h2>Final Step: Full Code (Copy-Paste)</h2>
        <p>This is the complete single-page sample. Start with this, then adapt labels and triage policy to your domain.</p>
        <BuzzCodeBlock Code="@_fullExampleSnippet"
                       Language="razor"
                       ShowLineNumbers="false"
                       EnableCopyButton="true" />
    </section>
</div>

@code {
    private sealed record MedicalCase(
        Guid Id,
        string PatientName,
        string Complaint,
        string Severity,
        string ArrivalDate,
        int? Spo2,
        bool NeedsImmediateReview,
        bool IsClosed);

    private string _patientName = string.Empty;
    private string _complaint = string.Empty;
    private string _severity = "Medium";
    private string _arrivalDate = DateTime.UtcNow.Date.ToString("yyyy-MM-dd");
    private string _spo2 = string.Empty;
    private bool _needsImmediateReview;
    private string _handoverDraft = "Patient is under triage assessment. Monitoring symptoms and vital risk indicators.";

    private readonly string _aiContextText =
        "Emergency triage workflow for outpatient intake. Prioritize unstable vitals and rapid escalation clarity.";

    private readonly IReadOnlyList<string> _severityOptions = ["Low", "Medium", "High", "Critical"];

    private readonly List<MedicalCase> _cases =
    [
        new(Guid.NewGuid(), "Mila Stone", "Chest pain with shortness of breath", "Critical", DateTime.UtcNow.Date.ToString("yyyy-MM-dd"), 90, true, false),
        new(Guid.NewGuid(), "Samir Khan", "Fever and cough", "Medium", DateTime.UtcNow.Date.ToString("yyyy-MM-dd"), 95, false, false)
    ];

    private readonly IReadOnlyList<BuzzStepItem> _steps =
    [
        new("Create model", "Define a medical case model with triage fields.", true),
        new("Build intake UI", "Capture complaint and severity with Buzz inputs."),
        new("Add workflow actions", "Add cases, seed sample data, and display critical alerts."),
        new("Enable AI assistant", "Use FormAssistant and SmartTable with subject-based AI context."),
        new("Ship seed context", "Bootstrap seed knowledge so first deployment has useful suggestions."),
        new("Copy final code", "Use the full sample and adapt for your hospital/clinic flow.")
    ];

    private readonly IReadOnlyList<BuzzTableColumn> _tableColumns =
    [
        new("patient", "Patient", BuzzTableDataType.Text, false, null, null, BuzzTableAggregationType.Count),
        new("complaint", "Complaint", BuzzTableDataType.Text, false, null, null, BuzzTableAggregationType.DistinctCount),
        new("severity", "Severity", BuzzTableDataType.Text, false, null, null, BuzzTableAggregationType.None),
        new("arrival", "Arrival", BuzzTableDataType.Date, true, "d", "en-US", BuzzTableAggregationType.Max),
        new("spo2", "SpO2", BuzzTableDataType.Number, true, "N0", "en-US", BuzzTableAggregationType.Min),
        new("review", "Immediate Review", BuzzTableDataType.Boolean, true, null, null, BuzzTableAggregationType.None)
    ];

    private readonly string _modelSnippet =
        "private sealed record MedicalCase(\\n" +
        "    Guid Id,\\n" +
        "    string PatientName,\\n" +
        "    string Complaint,\\n" +
        "    string Severity,\\n" +
        "    string ArrivalDate,\\n" +
        "    int? Spo2,\\n" +
        "    bool NeedsImmediateReview,\\n" +
        "    bool IsClosed);";

    private readonly string _intakeSnippet =
        "<BuzzTextBox Label=\\\"Patient Name\\\" @bind-InputText=\\\"_patientName\\\" />\\n" +
        "<BuzzTextBox Label=\\\"Primary Complaint\\\" @bind-InputText=\\\"_complaint\\\" />\\n" +
        "<BuzzSelectBox Label=\\\"Triage Severity\\\" Options=\\\"@_severityOptions\\\" @bind-Value=\\\"_severity\\\" />\\n" +
        "<BuzzDatePicker Label=\\\"Arrival Date\\\" @bind-Value=\\\"_arrivalDate\\\" />\\n" +
        "<BuzzCheckBox Label=\\\"Requires immediate physician review\\\" @bind-Value=\\\"_needsImmediateReview\\\" />";

    private readonly string _workflowSnippet =
        "<BuzzButton Text=\\\"Add Case\\\" Variant=\\\"primary\\\" OnClick=\\\"AddCaseAsync\\\" />\\n" +
        "<BuzzAlert Title=\\\"Critical Cases Detected\\\" Variant=\\\"warning\\\" Dismissible=\\\"false\\\" />\\n" +
        "<BuzzProgress Label=\\\"Active high-risk ratio\\\" Value=\\\"@HighRiskPercent\\\" Max=\\\"100\\\" />";

    private readonly string _aiSnippet =
        "<BuzzFormAssistant AiContextSubject=\\\"medical-triage\\\" SourceText=\\\"@_aiContextText\\\" />\\n" +
        "<BuzzSmartTable AiContextSubject=\\\"medical-triage\\\" SourceText=\\\"@_aiContextText\\\" />";

    private readonly string _bootstrapSnippet =
        "{\\n" +
        "  \\\"Buzz\\\": {\\n" +
        "    \\\"EnableAiContextEnrichment\\\": true,\\n" +
        "    \\\"EnableSeedKnowledgeBootstrap\\\": true,\\n" +
        "    \\\"SeedKnowledgeFilePath\\\": \\\"seed/buzz-seed-knowledge.json\\\",\\n" +
        "    \\\"EnableSeedKnowledgeWarmupOnStartup\\\": true\\n" +
        "  }\\n" +
        "}";

    private readonly string _seedSnippet =
        "{\\n" +
        "  \\\"subject\\\": \\\"medical-triage\\\",\\n" +
        "  \\\"component\\\": \\\"BuzzFormAssistant\\\",\\n" +
        "  \\\"title\\\": \\\"Triage escalation baseline\\\",\\n" +
        "  \\\"text\\\": \\\"Escalate when SpO2 is below 92 or severe chest pain is present.\\\",\\n" +
        "  \\\"tags\\\": [\\\"triage\\\", \\\"risk\\\", \\\"escalation\\\"]\\n" +
        "}";

    private readonly string _fullExampleSnippet =
        """
        @page "/medical-triage"
        @rendermode InteractiveServer
        @using Buzz.Blazor.Models

        <h1>Medical Triage</h1>

        <BuzzTextBox Label="Patient Name" InputText="@_patientName" InputTextChanged="OnPatientNameChanged" />
        <BuzzTextBox Label="Primary Complaint" InputText="@_complaint" InputTextChanged="OnComplaintChanged" />
        <BuzzSelectBox Label="Triage Severity" Options="@_severityOptions" Value="@_severity" ValueChanged="OnSeverityChanged" />
        <BuzzDatePicker Label="Arrival Date" Value="@_arrivalDate" ValueChanged="OnArrivalDateChanged" />
        <BuzzTextBox Label="SpO2 (%)" InputText="@_spo2" InputTextChanged="OnSpo2Changed" />
        <BuzzCheckBox Label="Requires immediate physician review" Value="@_needsImmediateReview" ValueChanged="OnNeedsImmediateReviewChanged" />

        <BuzzStack Direction="horizontal" Gap="0.45rem" Wrap="true" Align="center">
            <BuzzButton Text="Add Case" Variant="primary" OnClick="AddCaseAsync" />
            <BuzzButton Text="Seed Example Cases" Variant="outline" OnClick="SeedCasesAsync" />
            <BuzzButton Text="Clear Closed Cases" Variant="secondary" OnClick="ClearClosedCasesAsync" />
        </BuzzStack>

        @if (HasCriticalCases)
        {
            <BuzzAlert Title="Critical Cases Detected"
                       Message="At least one active case is high risk. Review triage actions now."
                       Variant="warning"
                       Dismissible="false" />
        }

        <BuzzProgress Label="Active high-risk ratio" Value="@HighRiskPercent" Max="100" Variant="danger" ShowValueLabel="true" />

        <BuzzFormAssistant Label="Clinical Note Assistant"
                           Fields="@AssistantFields"
                           EnableAiRiskInsight="true"
                           EnableAiRewriteForMessage="true"
                           MessageDraft="@_handoverDraft"
                           MessageDraftChanged="OnHandoverDraftChanged"
                           AiContextSubject="medical-triage"
                           SourceText="@_aiContextText" />

        <BuzzSmartTable Label="Live Triage Board"
                        Columns="@_tableColumns"
                        Rows="@TableRows"
                        Modules="@BuzzSmartTableModules.Analytics"
                        ShowAiInsightsPanel="true"
                        EnableAiInsights="true"
                        AiContextSubject="medical-triage"
                        SourceText="@_aiContextText" />

        @code {
            private sealed record MedicalCase(
                Guid Id,
                string PatientName,
                string Complaint,
                string Severity,
                string ArrivalDate,
                int? Spo2,
                bool NeedsImmediateReview,
                bool IsClosed);

            private string _patientName = string.Empty;
            private string _complaint = string.Empty;
            private string _severity = "Medium";
            private string _arrivalDate = DateTime.UtcNow.Date.ToString("yyyy-MM-dd");
            private string _spo2 = string.Empty;
            private bool _needsImmediateReview;
            private string _handoverDraft = "Patient is under triage assessment.";
            private readonly string _aiContextText = "Emergency triage workflow for outpatient intake.";
            private readonly IReadOnlyList<string> _severityOptions = ["Low", "Medium", "High", "Critical"];

            private readonly List<MedicalCase> _cases =
            [
                new(Guid.NewGuid(), "Mila Stone", "Chest pain with shortness of breath", "Critical", DateTime.UtcNow.Date.ToString("yyyy-MM-dd"), 90, true, false),
                new(Guid.NewGuid(), "Samir Khan", "Fever and cough", "Medium", DateTime.UtcNow.Date.ToString("yyyy-MM-dd"), 95, false, false)
            ];

            private readonly IReadOnlyList<BuzzTableColumn> _tableColumns =
            [
                new("patient", "Patient", BuzzTableDataType.Text),
                new("complaint", "Complaint", BuzzTableDataType.Text),
                new("severity", "Severity", BuzzTableDataType.Text),
                new("arrival", "Arrival", BuzzTableDataType.Date),
                new("spo2", "SpO2", BuzzTableDataType.Number),
                new("review", "Immediate Review", BuzzTableDataType.Boolean)
            ];

            private IReadOnlyList<BuzzFormFieldState> AssistantFields =>
            [
                new("patient", "Patient Name", _patientName, true),
                new("complaint", "Primary Complaint", _complaint, true),
                new("severity", "Triage Severity", _severity, true)
            ];

            private IReadOnlyList<IReadOnlyDictionary<string, string>> TableRows =>
                _cases.Where(entry => !entry.IsClosed)
                     .Select(entry => new Dictionary<string, string>
                     {
                         ["patient"] = entry.PatientName,
                         ["complaint"] = entry.Complaint,
                         ["severity"] = entry.Severity,
                         ["arrival"] = entry.ArrivalDate,
                         ["spo2"] = entry.Spo2?.ToString() ?? string.Empty,
                         ["review"] = entry.NeedsImmediateReview ? "true" : "false"
                     })
                     .ToList();

            private bool HasCriticalCases => _cases.Any(entry => !entry.IsClosed && (entry.Spo2 is <= 91 || entry.Severity is "Critical"));
            private double HighRiskPercent => _cases.Count == 0 ? 0 : Math.Round((_cases.Count(entry => !entry.IsClosed && (entry.NeedsImmediateReview || entry.Severity is "High" or "Critical")) / (double)_cases.Count) * 100, 2);

            private Task OnPatientNameChanged(string value) { _patientName = value; return Task.CompletedTask; }
            private Task OnComplaintChanged(string value) { _complaint = value; return Task.CompletedTask; }
            private Task OnSeverityChanged(string value) { _severity = string.IsNullOrWhiteSpace(value) ? "Medium" : value; return Task.CompletedTask; }
            private Task OnArrivalDateChanged(string value) { _arrivalDate = string.IsNullOrWhiteSpace(value) ? DateTime.UtcNow.Date.ToString("yyyy-MM-dd") : value; return Task.CompletedTask; }
            private Task OnSpo2Changed(string value) { _spo2 = value; return Task.CompletedTask; }
            private Task OnNeedsImmediateReviewChanged(bool value) { _needsImmediateReview = value; return Task.CompletedTask; }
            private Task OnHandoverDraftChanged(string value) { _handoverDraft = value; return Task.CompletedTask; }

            private Task AddCaseAsync()
            {
                if (string.IsNullOrWhiteSpace(_complaint))
                {
                    return Task.CompletedTask;
                }

                _cases.Insert(0, new MedicalCase(
                    Guid.NewGuid(),
                    string.IsNullOrWhiteSpace(_patientName) ? "Unknown" : _patientName.Trim(),
                    _complaint.Trim(),
                    _severity,
                    _arrivalDate,
                    int.TryParse(_spo2, out var spo2) ? spo2 : null,
                    _needsImmediateReview,
                    false));

                _patientName = string.Empty;
                _complaint = string.Empty;
                _spo2 = string.Empty;
                _needsImmediateReview = false;
                return Task.CompletedTask;
            }

            private Task SeedCasesAsync()
            {
                _cases.Add(new MedicalCase(Guid.NewGuid(), "Anita Wells", "Dizziness and low oxygen reading", "High", DateTime.UtcNow.Date.ToString("yyyy-MM-dd"), 91, true, false));
                return Task.CompletedTask;
            }

            private Task ClearClosedCasesAsync()
            {
                _cases.RemoveAll(entry => entry.IsClosed);
                return Task.CompletedTask;
            }
        }
        """;

    private IReadOnlyList<BuzzFormFieldState> AssistantFields =>
    [
        new("patient", "Patient Name", _patientName, true),
        new("complaint", "Primary Complaint", _complaint, true),
        new("severity", "Triage Severity", _severity, true),
        new("arrival", "Arrival Date", _arrivalDate, true),
        new("handover", "Clinical Handover Draft", _handoverDraft, true)
    ];

    private IReadOnlyList<IReadOnlyDictionary<string, string>> TableRows =>
        _cases
            .Where(entry => !entry.IsClosed)
            .Select(entry => new Dictionary<string, string>
            {
                ["patient"] = entry.PatientName,
                ["complaint"] = entry.Complaint,
                ["severity"] = entry.Severity,
                ["arrival"] = entry.ArrivalDate,
                ["spo2"] = entry.Spo2?.ToString() ?? string.Empty,
                ["review"] = entry.NeedsImmediateReview ? "true" : "false"
            })
            .ToList();

    private bool HasCriticalCases =>
        _cases.Any(entry =>
            !entry.IsClosed &&
            (string.Equals(entry.Severity, "Critical", StringComparison.OrdinalIgnoreCase) || entry.Spo2 is <= 91));

    private double HighRiskPercent
    {
        get
        {
            var active = _cases.Where(entry => !entry.IsClosed).ToList();
            if (active.Count == 0)
            {
                return 0;
            }

            var highRisk = active.Count(entry =>
                entry.NeedsImmediateReview ||
                string.Equals(entry.Severity, "High", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(entry.Severity, "Critical", StringComparison.OrdinalIgnoreCase) ||
                entry.Spo2 is <= 92);

            return Math.Round((highRisk / (double)active.Count) * 100, 2);
        }
    }

    private Task OnPatientNameChanged(string value) { _patientName = value; return Task.CompletedTask; }
    private Task OnComplaintChanged(string value) { _complaint = value; return Task.CompletedTask; }
    private Task OnSeverityChanged(string value) { _severity = string.IsNullOrWhiteSpace(value) ? "Medium" : value; return Task.CompletedTask; }
    private Task OnArrivalDateChanged(string value) { _arrivalDate = string.IsNullOrWhiteSpace(value) ? DateTime.UtcNow.Date.ToString("yyyy-MM-dd") : value; return Task.CompletedTask; }
    private Task OnSpo2Changed(string value) { _spo2 = value; return Task.CompletedTask; }
    private Task OnNeedsImmediateReviewChanged(bool value) { _needsImmediateReview = value; return Task.CompletedTask; }
    private Task OnHandoverDraftChanged(string value) { _handoverDraft = value; return Task.CompletedTask; }

    private Task AddCaseAsync()
    {
        var complaint = _complaint.Trim();
        if (string.IsNullOrWhiteSpace(complaint))
        {
            return Task.CompletedTask;
        }

        _cases.Insert(0, new MedicalCase(
            Guid.NewGuid(),
            string.IsNullOrWhiteSpace(_patientName) ? "Unknown" : _patientName.Trim(),
            complaint,
            _severity,
            NormalizeDate(_arrivalDate),
            ParseNullableInt(_spo2),
            _needsImmediateReview,
            false));

        _patientName = string.Empty;
        _complaint = string.Empty;
        _spo2 = string.Empty;
        _needsImmediateReview = false;
        return Task.CompletedTask;
    }

    private Task SeedCasesAsync()
    {
        _cases.Add(new MedicalCase(
            Guid.NewGuid(),
            "Anita Wells",
            "Dizziness and low oxygen reading",
            "High",
            DateTime.UtcNow.Date.ToString("yyyy-MM-dd"),
            91,
            true,
            false));
        return Task.CompletedTask;
    }

    private Task ClearClosedCasesAsync()
    {
        _cases.RemoveAll(entry => entry.IsClosed);
        return Task.CompletedTask;
    }

    private static int? ParseNullableInt(string value) =>
        int.TryParse(value, out var parsed) ? parsed : null;

    private static string NormalizeDate(string value) =>
        DateTime.TryParse(value, out var parsed)
            ? parsed.ToString("yyyy-MM-dd")
            : DateTime.UtcNow.Date.ToString("yyyy-MM-dd");
}

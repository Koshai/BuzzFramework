<span class="buzz-badge buzz-badge-@NormalizeVariant(Variant)">
    @Text
</span>

@code {
    [Parameter]
    public string Text { get; set; } = "Badge";

    [Parameter]
    public string Variant { get; set; } = "neutral";

    private static string NormalizeVariant(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "neutral";
        }

        return value.Trim().ToLowerInvariant() switch
        {
            "success" => "success",
            "warning" => "warning",
            "danger" => "danger",
            "info" => "info",
            _ => "neutral"
        };
    }
}

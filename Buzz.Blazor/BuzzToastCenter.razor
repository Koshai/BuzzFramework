@using Buzz.Blazor.Models

<section class="buzz-toast-center" aria-label="@Label">
    @for (var index = 0; index < _items.Count; index++)
    {
        var toast = _items[index];
        <BuzzToast
            Title="@toast.Title"
            Message="@toast.Message"
            Severity="@toast.Severity"
            SourceText="@toast.SourceText"
            EnableAiMessageWhenEmpty="@toast.EnableAiMessageWhenEmpty"
            AutoGenerateAiWhenEmpty="@toast.AutoGenerateAiWhenEmpty"
            IsVisible="true"
            IsVisibleChanged="@((visible) => OnToastVisibilityChangedAsync(index, visible))" />
    }
</section>

@code {
    [Parameter]
    public string Label { get; set; } = "Toast center";

    [Parameter]
    public IReadOnlyList<BuzzToastItem> Items { get; set; } = Array.Empty<BuzzToastItem>();

    [Parameter]
    public EventCallback<IReadOnlyList<BuzzToastItem>> ItemsChanged { get; set; }

    private readonly List<BuzzToastItem> _items = [];

    protected override void OnParametersSet()
    {
        _items.Clear();
        _items.AddRange(Items);
    }

    private async Task OnToastVisibilityChangedAsync(int index, bool visible)
    {
        if (visible)
        {
            return;
        }

        if (index < 0 || index >= _items.Count)
        {
            return;
        }

        _items.RemoveAt(index);
        await ItemsChanged.InvokeAsync(_items.ToList());
    }
}

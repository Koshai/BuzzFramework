<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Buzz.Samples.styles.css"]" />
    <script>
        (function () {
            try {
                var theme = localStorage.getItem("buzz-active-theme") || "azure";
                document.documentElement.setAttribute("data-buzz-theme", theme);
            } catch {
                document.documentElement.setAttribute("data-buzz-theme", "azure");
            }
        })();
    </script>
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["guide-copy.js"]"></script>
    <script src="@Assets["buzz-theme.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Buzz.Core\Buzz.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <PackageId>Buzz.Framework.Provider.OpenAI</PackageId>
    <Version>0.1.0-preview.2</Version>
    <Authors>Buzz Framework Team</Authors>
    <Description>OpenAI provider integration for Buzz Framework AI pipelines.</Description>
    <PackageTags>buzz;blazor;ai;openai;provider</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://example.com/buzz-framework</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

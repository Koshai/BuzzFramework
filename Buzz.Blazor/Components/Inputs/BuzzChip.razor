<span class="buzz-chip buzz-chip-@NormalizeVariant(Variant)">
    @if (!string.IsNullOrWhiteSpace(LeadingIcon))
    {
        <span class="buzz-chip-icon" aria-hidden="true">@LeadingIcon</span>
    }

    <button type="button" class="buzz-chip-label" disabled="@Disabled" @onclick="HandleClickAsync">@Text</button>

    @if (Removable)
    {
        <button type="button" class="buzz-chip-remove" disabled="@Disabled" @onclick="HandleRemoveAsync" aria-label="Remove @Text">x</button>
    }
</span>

@code {
    /// <summary>
    /// Chip label text.
    /// </summary>
    [Parameter]
    public string Text { get; set; } = "Chip";

    /// <summary>
    /// Chip visual variant.
    /// </summary>
    [Parameter]
    public string Variant { get; set; } = "neutral";

    /// <summary>
    /// Optional leading icon text.
    /// </summary>
    [Parameter]
    public string? LeadingIcon { get; set; }

    /// <summary>
    /// Shows remove action button.
    /// </summary>
    [Parameter]
    public bool Removable { get; set; }

    /// <summary>
    /// Disables chip interactions.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Callback invoked when chip body is clicked.
    /// </summary>
    [Parameter]
    public EventCallback OnClick { get; set; }

    /// <summary>
    /// Callback invoked when remove action is clicked.
    /// </summary>
    [Parameter]
    public EventCallback OnRemove { get; set; }

    private async Task HandleClickAsync()
    {
        if (Disabled)
        {
            return;
        }

        await OnClick.InvokeAsync();
    }

    private async Task HandleRemoveAsync()
    {
        if (Disabled)
        {
            return;
        }

        await OnRemove.InvokeAsync();
    }

    private static string NormalizeVariant(string? value) =>
        value?.Trim().ToLowerInvariant() switch
        {
            "accent" => "accent",
            "success" => "success",
            "warning" => "warning",
            "danger" => "danger",
            _ => "neutral"
        };
}

@using Buzz.Blazor.Models

<footer class="buzz-footer">
    <div class="buzz-footer-inner">
        <div class="buzz-footer-branding">
            <strong>@BrandText</strong>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p>@Description</p>
            }
        </div>

        <nav class="buzz-footer-links" aria-label="Footer links">
            @foreach (var link in Links)
            {
                <a href="@link.Href">@link.Text</a>
            }
        </nav>
    </div>
    <p class="buzz-footer-copy">@Copyright</p>
</footer>

@code {
    /// <summary>
    /// Footer brand label.
    /// </summary>
    [Parameter]
    public string BrandText { get; set; } = "Buzz";

    /// <summary>
    /// Optional footer description text.
    /// </summary>
    [Parameter]
    public string Description { get; set; } = string.Empty;

    /// <summary>
    /// Footer link collection.
    /// </summary>
    [Parameter]
    public IReadOnlyList<BuzzNavLink> Links { get; set; } = Array.Empty<BuzzNavLink>();

    /// <summary>
    /// Footer copyright line.
    /// </summary>
    [Parameter]
    public string Copyright { get; set; } =
        $"Copyright {DateTime.Now.Year} Buzz Framework";
}

@inherits LayoutComponentBase
@using Buzz.Blazor.Models
@inject IJSRuntime JS

<div class="page" data-buzz-theme="@_activeTheme">
    <BuzzNavBar BrandText="BuzzBlazor"
                BrandHref="/"
                Links="@_primaryLinks">
        <Actions>
            <label class="buzz-theme-label" for="buzz-theme-select">Theme</label>
            <select id="buzz-theme-select" class="buzz-theme-select" @bind="_selectedTheme">
                @foreach (var option in _themeItems)
                {
                    <option value="@option.Value">@option.Text</option>
                }
            </select>
            <button type="button"
                    class="buzz-theme-apply-button"
                    @onclick="ApplySelectedThemeAsync">
                Apply
            </button>
            <span class="buzz-theme-indicator">@_activeThemeLabel</span>
            <a class="buzz-navbar-doc-link" href="/getting-started">Start Building</a>
        </Actions>
    </BuzzNavBar>

    <main class="page-main">
        <article class="content">
            @Body
        </article>
    </main>

    <BuzzFooter BrandText="BuzzBlazor"
                Description="AI-ready Blazor components for modern web development."
                Links="@_footerLinks"
                Copyright="@($"Copyright {DateTime.UtcNow.Year} BuzzBlazor")" />
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private readonly IReadOnlyList<BuzzNavLink> _primaryLinks =
    [
        new("Home", "/", true),
        new("Components", "/demo"),
        new("Getting Started", "/getting-started"),
        new("Installation", "/installation"),
        new("Medical Tutorial", "/tutorial-medical"),
        new("Developer Guide", "/developer-guide"),
        new("Accessibility", "/accessibility-checklist")
    ];

    private readonly IReadOnlyList<BuzzNavLink> _footerLinks =
    [
        new("Home", "/"),
        new("Components", "/demo"),
        new("Getting Started", "/getting-started"),
        new("Installation", "/installation"),
        new("Medical Tutorial", "/tutorial-medical"),
        new("Developer Guide", "/developer-guide"),
        new("Accessibility", "/accessibility-checklist")
    ];

    private readonly IReadOnlyList<BuzzMenuItem> _themeItems =
    [
        new("Azure Pulse", "azure"),
        new("Emerald Flow", "emerald"),
        new("Violet Prism", "violet"),
        new("Sunset Coral", "coral"),
        new("Slate Mono", "slate")
    ];

    private string _activeTheme = "azure";
    private string _selectedTheme = "azure";
    private string _activeThemeLabel = "Azure Pulse";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var stored = _activeTheme;
        try
        {
            stored = await JS.InvokeAsync<string>("buzzTheme.getStoredTheme");
        }
        catch
        {
            // Keep the in-memory fallback if JS interop is unavailable.
        }

        await ApplyThemeAsync(stored);
    }

    private Task ApplySelectedThemeAsync() => ApplyThemeAsync(_selectedTheme);

    private async Task ApplyThemeAsync(string? requestedTheme)
    {
        var selected = requestedTheme ?? "azure";
        var match = _themeItems.FirstOrDefault(item => string.Equals(item.Value, selected, StringComparison.OrdinalIgnoreCase));
        if (match is null)
        {
            _activeTheme = "azure";
            _selectedTheme = "azure";
            _activeThemeLabel = "Azure Pulse";
            await TryApplyThemeToDocumentAsync(_activeTheme);
            StateHasChanged();
            return;
        }

        _activeTheme = match.Value;
        _selectedTheme = match.Value;
        _activeThemeLabel = match.Text;
        await TryApplyThemeToDocumentAsync(_activeTheme);
        StateHasChanged();
    }

    private async Task TryApplyThemeToDocumentAsync(string theme)
    {
        try
        {
            await JS.InvokeAsync<string>("buzzTheme.apply", theme);
        }
        catch
        {
            // Page-level data-buzz-theme still updates visual theme if JS fails.
        }
    }
}

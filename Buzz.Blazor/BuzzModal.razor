@using Buzz.Core
@using Microsoft.Extensions.Logging
@inject IBuzzClient BuzzClient
@inject ILogger<BuzzModal> Logger

@if (IsOpen)
{
    <div class="buzz-modal-backdrop" @onclick="HandleBackdropClickAsync">
        <section
            class="buzz-modal"
            role="dialog"
            aria-modal="true"
            aria-labelledby="@_titleId"
            @onclick:stopPropagation="true">
            <header class="buzz-modal-header">
                <h3 id="@_titleId" class="buzz-modal-title">@Title</h3>
                <button type="button" class="buzz-modal-close" @onclick="CloseAsync" aria-label="Close dialog">x</button>
            </header>

            @if (ChildContent is not null)
            {
                <div class="buzz-modal-content">
                    @ChildContent
                </div>
            }

            @if (EnableAiInsight)
            {
                <div class="buzz-modal-ai">
                    <button
                        type="button"
                        class="buzz-modal-ai-button"
                        @onclick="GenerateInsightAsync"
                        disabled="@_isGenerating">
                        @(_isGenerating ? "Generating..." : "Generate AI Insight")
                    </button>

                    @if (!string.IsNullOrWhiteSpace(_insight))
                    {
                        <p class="buzz-modal-ai-text">@_insight</p>
                    }

                    @if (!string.IsNullOrWhiteSpace(_error))
                    {
                        <p class="buzz-modal-ai-error">@_error</p>
                    }
                </div>
            }

            <footer class="buzz-modal-footer">
                @if (Actions is not null)
                {
                    @Actions
                }
                else
                {
                    <button type="button" class="buzz-modal-secondary" @onclick="CloseAsync">@CloseButtonText</button>
                }
            </footer>
        </section>
    </div>
}

@code {
    [Parameter]
    public string Title { get; set; } = "Buzz Modal";

    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    [Parameter]
    public bool CloseOnBackdropClick { get; set; } = true;

    [Parameter]
    public bool EnableAiInsight { get; set; } = true;

    [Parameter]
    public bool AutoGenerateOnOpen { get; set; } = false;

    [Parameter]
    public string SourceText { get; set; } = string.Empty;

    [Parameter]
    public string CloseButtonText { get; set; } = "Close";

    private readonly string _titleId = $"buzz-modal-title-{Guid.NewGuid():N}";
    private bool _isGenerating;
    private string? _insight;
    private string? _error;
    private bool _wasOpen;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen && !_wasOpen && AutoGenerateOnOpen && EnableAiInsight)
        {
            await GenerateInsightAsync();
        }

        _wasOpen = IsOpen;
    }

    private async Task HandleBackdropClickAsync()
    {
        if (CloseOnBackdropClick)
        {
            await CloseAsync();
        }
    }

    private async Task CloseAsync()
    {
        await IsOpenChanged.InvokeAsync(false);
    }

    private async Task GenerateInsightAsync()
    {
        var source = (SourceText ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(source))
        {
            _error = "Provide source text to generate insight.";
            _insight = null;
            return;
        }

        _error = null;
        _isGenerating = true;
        try
        {
            var response = await BuzzClient.GenerateAsync(
                new BuzzRequest(
                    source,
                    "Provide a concise decision-support insight for this modal context in one or two sentences.",
                    $"ModalTitle: {Title}"));

            _insight = response.OutputText?.Trim();
            if (string.IsNullOrWhiteSpace(_insight))
            {
                _insight = "No insight returned.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "BuzzModal insight generation failed.");
            _error = "AI provider is unavailable right now.";
        }
        finally
        {
            _isGenerating = false;
        }
    }
}

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>true</IsPackable>
    <PackageId>Buzz.Framework.Core</PackageId>
    <Version>0.1.0-preview.2</Version>
    <Authors>Buzz Framework Team</Authors>
    <Description>Core abstractions and contracts used by the Buzz Framework component ecosystem.</Description>
    <PackageTags>buzz;blazor;ai;framework;core</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://example.com/buzz-framework</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

@using Buzz.Blazor.Models
@using Buzz.Blazor.Services
@inject IBuzzToggleAdvisor ToggleAdvisor
@inject NavigationManager NavigationManager

<div class="buzz-checkbox">
    <div class="buzz-checkbox-row">
        <input
            id="@_checkboxId"
            class="buzz-checkbox-input"
            type="checkbox"
            checked="@Value"
            disabled="@Disabled"
            required="@Required"
            aria-required="@Required"
            aria-invalid="@HasErrorText"
            aria-describedby="@ResolvedDescribedBy"
            @onchange="HandleChangedAsync" />
        <label class="buzz-checkbox-label" for="@_checkboxId">@Label</label>
    </div>

    @if (ShowRecommendationHint && _recommendation.HasRecommendation)
    {
        <p id="@_recommendationId" class="buzz-checkbox-recommendation">
            Recommended: <strong>@(_recommendation.RecommendedValue ? "Enabled" : "Disabled")</strong>
            @if (!string.IsNullOrWhiteSpace(_recommendation.Reason))
            {
                <span class="buzz-checkbox-recommendation-reason">(@_recommendation.Reason, @_recommendation.ConfidencePercent%)</span>
            }
        </p>
    }

    @if (!string.IsNullOrWhiteSpace(HelperText))
    {
        <p id="@_helperTextId" class="buzz-checkbox-helper">@HelperText</p>
    }

    @if (HasErrorText)
    {
        <p id="@_errorTextId" class="buzz-checkbox-error">@ErrorText</p>
    }
</div>

@code {
    [Parameter]
    public string Label { get; set; } = "Buzz Check Box";

    [Parameter]
    public bool Value { get; set; }

    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public bool ShowRecommendationHint { get; set; } = true;

    [Parameter]
    public string? MemorySubject { get; set; }

    [Parameter]
    public string? ReferenceText { get; set; }

    [Parameter]
    public string? HelperText { get; set; }

    [Parameter]
    public string? ErrorText { get; set; }

    [Parameter]
    public string? DescribedBy { get; set; }

    private readonly string _checkboxId = $"buzz-checkbox-{Guid.NewGuid():N}";
    private readonly string _helperTextId = $"buzz-checkbox-helper-{Guid.NewGuid():N}";
    private readonly string _errorTextId = $"buzz-checkbox-error-{Guid.NewGuid():N}";
    private readonly string _recommendationId = $"buzz-checkbox-recommendation-{Guid.NewGuid():N}";
    private BuzzToggleRecommendation _recommendation = new(false, false, null, 0);
    private bool HasErrorText => !string.IsNullOrWhiteSpace(ErrorText);

    private string? ResolvedDescribedBy
    {
        get
        {
            var ids = new List<string>();
            if (!string.IsNullOrWhiteSpace(DescribedBy))
            {
                ids.Add(DescribedBy.Trim());
            }

            if (ShowRecommendationHint && _recommendation.HasRecommendation)
            {
                ids.Add(_recommendationId);
            }

            if (!string.IsNullOrWhiteSpace(HelperText))
            {
                ids.Add(_helperTextId);
            }

            if (HasErrorText)
            {
                ids.Add(_errorTextId);
            }

            return ids.Count == 0 ? null : string.Join(" ", ids);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _recommendation = await ToggleAdvisor.RecommendAsync(
            Label,
            CurrentPagePath(),
            MemorySubject,
            ReferenceText);
    }

    private async Task HandleChangedAsync(ChangeEventArgs args)
    {
        var checkedValue = args.Value as bool? ?? false;
        await ValueChanged.InvokeAsync(checkedValue);
        await ToggleAdvisor.RememberSelectionAsync(
            checkedValue,
            Label,
            CurrentPagePath(),
            MemorySubject,
            ReferenceText);
    }

    private string CurrentPagePath()
    {
        var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        return string.IsNullOrWhiteSpace(relative) ? "/" : $"/{relative}";
    }
}

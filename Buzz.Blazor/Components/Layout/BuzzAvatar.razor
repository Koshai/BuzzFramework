<div class="buzz-avatar buzz-avatar-@NormalizeSize(Size) buzz-avatar-@NormalizeShape(Shape) buzz-avatar-@NormalizeVariant(Variant)" title="@Name">
    @if (!string.IsNullOrWhiteSpace(ImageUrl))
    {
        <img src="@ImageUrl" alt="@Name" class="buzz-avatar-image" />
    }
    else
    {
        <span aria-hidden="true">@ResolveInitials()</span>
    }

    @if (ShowStatusDot)
    {
        <span class="buzz-avatar-status buzz-avatar-status-@NormalizeStatus(Status)" aria-hidden="true"></span>
    }
</div>

@code {
    /// <summary>
    /// Display name used for tooltip, alt text, and initials.
    /// </summary>
    [Parameter]
    public string Name { get; set; } = "Buzz User";

    /// <summary>
    /// Optional avatar image URL.
    /// </summary>
    [Parameter]
    public string? ImageUrl { get; set; }

    /// <summary>
    /// Avatar size (sm, md, lg).
    /// </summary>
    [Parameter]
    public string Size { get; set; } = "md";

    /// <summary>
    /// Avatar shape (circle or rounded).
    /// </summary>
    [Parameter]
    public string Shape { get; set; } = "circle";

    /// <summary>
    /// Avatar color variant.
    /// </summary>
    [Parameter]
    public string Variant { get; set; } = "neutral";

    /// <summary>
    /// Displays an online/offline status indicator.
    /// </summary>
    [Parameter]
    public bool ShowStatusDot { get; set; }

    /// <summary>
    /// Status indicator value (online, offline, busy).
    /// </summary>
    [Parameter]
    public string Status { get; set; } = "online";

    private string ResolveInitials()
    {
        if (string.IsNullOrWhiteSpace(Name))
        {
            return "BU";
        }

        var parts = Name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
        {
            return parts[0].Length >= 2
                ? parts[0][..2].ToUpperInvariant()
                : parts[0].ToUpperInvariant();
        }

        return $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant();
    }

    private static string NormalizeSize(string? value) =>
        value?.Trim().ToLowerInvariant() switch
        {
            "sm" => "sm",
            "lg" => "lg",
            _ => "md"
        };

    private static string NormalizeShape(string? value) =>
        value?.Trim().ToLowerInvariant() switch
        {
            "rounded" => "rounded",
            _ => "circle"
        };

    private static string NormalizeVariant(string? value) =>
        value?.Trim().ToLowerInvariant() switch
        {
            "accent" => "accent",
            _ => "neutral"
        };

    private static string NormalizeStatus(string? value) =>
        value?.Trim().ToLowerInvariant() switch
        {
            "offline" => "offline",
            "busy" => "busy",
            _ => "online"
        };
}

@page "/textbox-demo"
@rendermode InteractiveServer
@using Buzz.Blazor.Models

<PageTitle>BuzzTextBox Demo</PageTitle>

<h1>BuzzTextBox Demo: Support Reply Workflow</h1>

<p class="textbox-demo-intro">
    Scenario: a support agent writes repeated responses throughout the day.
    Press <strong>Enter</strong> after each final input so Buzz can remember it.
    Over time, each field should suggest better phrases while you type.
</p>

<div class="textbox-demo-grid">
    <section class="textbox-demo-panel">
        <h3>1) Issue Summary</h3>
        <BuzzTextBox
            Label="Issue Summary"
            @bind-InputText="_issueSummary"
            MemorySubject="@_sharedSubject"
            SuggestionCount="6"
            AddToHistoryOnEnter="true"
            AddToHistoryOnTab="true"
            Placeholder="Example: Login fails after password reset..." />
    </section>

    <section class="textbox-demo-panel">
        <h3>2) Resolution Notes</h3>
        <BuzzTextBox
            Label="Resolution Notes"
            @bind-InputText="_resolutionNotes"
            MemorySubject="@_sharedSubject"
            ReferenceText="@_issueSummary"
            SuggestionCount="6"
            AddToHistoryOnEnter="true"
            AddToHistoryOnTab="true"
            Placeholder="Example: Cleared stale session and reissued token..." />
    </section>

    <section class="textbox-demo-panel">
        <h3>3) Follow-up Message</h3>
        <BuzzTextBox
            Label="Follow-up Message"
            @bind-InputText="_followUpMessage"
            MemorySubject="@_sharedSubject"
            ReferenceText="@_issueSummary"
            SuggestionCount="6"
            AddToHistoryOnEnter="true"
            AddToHistoryOnTab="true"
            Placeholder="Example: Please confirm if you can access the account now..." />
    </section>

    <section class="textbox-demo-panel">
        <h3>4) Temporary Password (secure input)</h3>
        <BuzzTextBox
            Label="Temporary Password"
            @bind-InputText="_temporaryPassword"
            InputType="password"
            AddToHistoryOnEnter="false"
            AddToHistoryOnTab="false"
            EnableAiSuggestions="false"
            Placeholder="Password is masked and never suggested..." />
    </section>

    <section class="textbox-demo-panel">
        <h3>5) Resolution Category (BuzzComboBox)</h3>
        <BuzzComboBox
            Label="Resolution Category"
            @bind-Value="_resolutionCategory"
            MemorySubject="@_sharedSubject"
            ReferenceText="@_issueSummary"
            Options="@_resolutionCategories"
            MaxVisibleOptions="6"
            Placeholder="Select or type a category..." />
    </section>

    <section class="textbox-demo-panel">
        <h3>6) Escalation Level (BuzzSelectBox)</h3>
        <BuzzSelectBox
            Label="Escalation Level"
            @bind-Value="_escalationLevel"
            MemorySubject="@_sharedSubject"
            ReferenceText="@_issueSummary"
            Options="@_escalationLevels"
            MaxVisibleOptions="5"
            PlaceholderOptionText="Choose escalation level..."
            Required="true"
            HelperText="Pick the level used to route this ticket to the right queue."
            ErrorText="@_escalationLevelError"
            ShowRecommendationHint="true" />
        <button class="btn btn-sm btn-outline-primary mt-2" @onclick="ValidateEscalation">
            Validate Escalation Selection
        </button>
    </section>

    <section class="textbox-demo-panel">
        <h3>7) Require MFA Reset (BuzzCheckBox)</h3>
        <BuzzCheckBox
            Label="Require MFA reset on next login"
            @bind-Value="_requireMfaReset"
            MemorySubject="@_sharedSubject"
            ReferenceText="@_issueSummary"
            Required="true"
            HelperText="Enable this for compromised accounts or high-risk login anomalies."
            ErrorText="@_mfaResetError"
            ShowRecommendationHint="true" />
        <button class="btn btn-sm btn-outline-primary mt-2" @onclick="ValidateMfaReset">
            Validate MFA Reset Selection
        </button>
    </section>

    <section class="textbox-demo-panel">
        <h3>8) Case Summary (BuzzCard)</h3>
        <BuzzCard
            Title="Support Case Summary"
            Subtitle="Generated from current form state"
            SourceText="@CaseSummarySource"
            EnableAiSummary="true"
            ShowGenerateButton="true">
            <ChildContent>
                <p><strong>Issue:</strong> @_issueSummary</p>
                <p><strong>Category:</strong> @_resolutionCategory</p>
                <p><strong>Escalation:</strong> @_escalationLevel</p>
                <p><strong>Require MFA Reset:</strong> @_requireMfaReset</p>
            </ChildContent>
            <Actions>
                <button class="btn btn-sm btn-outline-secondary" @onclick="CopySummarySeed">
                    Use Current State As Seed
                </button>
            </Actions>
        </BuzzCard>
    </section>

    <section class="textbox-demo-panel">
        <h3>9) Resolution Path (BuzzRadioGroup)</h3>
        <BuzzRadioGroup
            Label="Preferred Resolution Path"
            @bind-Value="_resolutionPath"
            Options="@_resolutionPaths"
            MemorySubject="@_sharedSubject"
            ReferenceText="@_issueSummary"
            Required="true"
            HelperText="Choose the path most likely to close this case with minimal risk."
            ErrorText="@_resolutionPathError"
            ShowRecommendationHint="true"
            ShowRankingReasons="true" />
        <button class="btn btn-sm btn-outline-primary mt-2" @onclick="ValidateResolutionPath">
            Validate Resolution Path
        </button>
    </section>

    <section class="textbox-demo-panel">
        <h3>10) Follow-up Date (BuzzDatePicker)</h3>
        <BuzzDatePicker
            Label="Follow-up Date"
            @bind-Value="_followUpDate"
            MemorySubject="@_sharedSubject"
            ReferenceText="@_issueSummary"
            Required="true"
            HelperText="Pick the date when the user should be contacted again."
            ErrorText="@_followUpDateError"
            ShowQuickSuggestions="true"
            ShowRecommendationHint="true" />
        <button class="btn btn-sm btn-outline-primary mt-2" @onclick="ValidateFollowUpDate">
            Validate Follow-up Date
        </button>
    </section>

    <section class="textbox-demo-panel">
        <h3>11) Case Review Dialog (BuzzModal)</h3>
        <p>Open a dialog before final submission to review context and generate a quick AI insight.</p>
        <button class="btn btn-sm btn-outline-primary" @onclick="OpenCaseReviewModal">
            Open Case Review Dialog
        </button>
        <BuzzModal
            Title="Final Case Review"
            @bind-IsOpen="_isCaseReviewModalOpen"
            SourceText="@CaseSummarySource"
            EnableAiInsight="true"
            AutoGenerateOnOpen="true">
            <ChildContent>
                <p><strong>Issue:</strong> @_issueSummary</p>
                <p><strong>Resolution Category:</strong> @_resolutionCategory</p>
                <p><strong>Escalation:</strong> @_escalationLevel</p>
                <p><strong>Resolution Path:</strong> @_resolutionPath</p>
                <p><strong>Follow-up Date:</strong> @_followUpDate</p>
            </ChildContent>
        </BuzzModal>
    </section>

    <section class="textbox-demo-panel">
        <h3>12) Save Notification (BuzzToast)</h3>
        <p>Developers can provide a direct message, or leave it empty and let AI explain raw outcomes.</p>
        <button class="btn btn-sm btn-outline-primary me-2" @onclick="ShowSuccessToast">
            Show Success Toast
        </button>
        <button class="btn btn-sm btn-outline-danger" @onclick="ShowErrorToast">
            Show Error Toast (AI explanation)
        </button>
        <BuzzToast
            Title="@_toastTitle"
            Message="@_toastMessage"
            @bind-IsVisible="_isToastVisible"
            Severity="@_toastSeverity"
            SourceText="@_toastSourceText"
            EnableAiMessageWhenEmpty="@_toastUseAiWhenEmpty"
            AutoGenerateAiWhenEmpty="true"
            AutoHide="true"
            UseAdaptiveAutoHide="true"
            AutoHideMilliseconds="5000" />
    </section>

    <section class="textbox-demo-panel">
        <h3>13) Field Help (BuzzTooltip)</h3>
        <p>
            Hover or focus the items below.
            First tooltip uses a developer message, second one uses AI to explain raw technical text.
        </p>
        <div class="d-flex flex-column gap-2">
            <BuzzTooltip
                Message="Escalation controls how quickly this case is routed to specialized teams."
                Placement="right">
                <span class="badge text-bg-secondary">Escalation Help</span>
            </BuzzTooltip>

            <BuzzTooltip
                Message=""
                SourceText="HTTP 200 OK indicates that the request succeeded and the server returned the expected response payload."
                EnableAiMessageWhenEmpty="true"
                AutoGenerateAiWhenEmpty="true"
                Placement="right">
                <span class="badge text-bg-info">Explain Technical Status</span>
            </BuzzTooltip>
        </div>
    </section>

    <section class="textbox-demo-panel">
        <h3>14) Troubleshooting Playbook (BuzzAccordion)</h3>
        <p>Expand sections manually, or let AI suggest which section is most relevant to the current case.</p>
        <BuzzAccordion
            Label="Support Case Playbook"
            Sections="@_playbookSections"
            AllowMultipleOpen="false"
            EnableAiRecommendedSection="true"
            AutoRecommendOnLoad="true"
            ShowRecommendationHint="true"
            SourceText="@CaseSummarySource" />
    </section>

    <section class="textbox-demo-panel">
        <h3>15) Resolution Views (BuzzTabs)</h3>
        <p>Switch between guided views. AI can recommend the most relevant tab based on case context.</p>
        <BuzzTabs
            Label="Case Resolution Views"
            Tabs="@_resolutionTabs"
            EnableAiRecommendedTab="true"
            AutoRecommendOnLoad="true"
            ShowRecommendationHint="true"
            SourceText="@CaseSummarySource" />
    </section>

    <section class="textbox-demo-panel">
        <h3>16) Guided Workflow (BuzzStepper)</h3>
        <p>Run a clear case workflow while AI can suggest the most relevant next step from current context.</p>
        <BuzzStepper
            Label="Case Handling Workflow"
            Steps="@_workflowSteps"
            ActiveStep="@_currentWorkflowStep"
            ActiveStepChanged="OnWorkflowStepChanged"
            AllowStepNavigation="true"
            EnableAiRecommendedStep="true"
            AutoRecommendOnLoad="true"
            ShowRecommendationHint="true"
            SourceText="@CaseSummarySource" />
    </section>

    <section class="textbox-demo-panel">
        <h3>17) Activity Trail (BuzzTimeline)</h3>
        <p>Review recent case events in sequence. AI can suggest which event should be investigated first.</p>
        <BuzzTimeline
            Label="Case Activity Timeline"
            Items="@_caseTimeline"
            EnableAiRecommendedEvent="true"
            AutoRecommendOnLoad="true"
            ShowRecommendationHint="true"
            SortDescending="true"
            SourceText="@CaseSummarySource" />
    </section>

    <section class="textbox-demo-panel">
        <h3>18) Quick Actions (BuzzCommandPalette)</h3>
        <p>Search and trigger common support actions faster. AI can suggest which command is likely most relevant.</p>
        <BuzzCommandPalette
            Label="Case Action Commands"
            Placeholder="Type action keywords..."
            Commands="@_commandPaletteItems"
            Query="@_paletteQuery"
            QueryChanged="OnPaletteQueryChanged"
            SelectedCommand="@_selectedCommand"
            SelectedCommandChanged="OnSelectedCommandChanged"
            EnableAiRecommendedCommand="true"
            AutoRecommendOnLoad="true"
            ShowRecommendationHint="true"
            SourceText="@CaseSummarySource" />
    </section>

    <section class="textbox-demo-panel">
        <h3>19) Case Snapshot Table (BuzzSmartTable)</h3>
        <p>Review key ticket attributes in a compact table. This sample uses the modular analytics preset plus saved views.</p>
        <BuzzSmartTable
            Label="Open Case Snapshot"
            Columns="@_tableColumns"
            Rows="@_tableRows"
            Modules="@BuzzSmartTableModules.Analytics"
            ShowSummaryFooter="true"
            ShowInsightsPanel="true"
            ShowAiInsightsPanel="true"
            ShowFilterPanel="true"
            EnableGlobalSearch="true"
            EnableGrouping="true"
            SavedViews="@_tableSavedViews"
            SavedViewsChanged="OnTableSavedViewsChanged"
            EnableAiRecommendedSort="true"
            AutoRecommendSortOnLoad="true"
            EnableAiInsights="true"
            AutoGenerateAiInsightsOnLoad="true"
            ShowRecommendationHint="true"
            ShowRowCount="true"
            HighlightFirstRow="true"
            SourceText="@CaseSummarySource" />
    </section>

    <section class="textbox-demo-panel">
        <h3>20) Pre-Submit Coach (BuzzFormAssistant)</h3>
        <p>Get a completion checklist, risk insight, and a rewritten user-facing message before final submit.</p>
        <BuzzFormAssistant
            Label="Case Submit Assistant"
            Fields="@FormAssistantFields"
            ShowChecklist="true"
            ShowCompletionScore="true"
            EnableAiRiskInsight="true"
            AutoGenerateRiskInsightOnLoad="true"
            EnableAiRewriteForMessage="true"
            MessageDraft="@_followUpMessage"
            MessageDraftChanged="OnFollowUpMessageChanged"
            SourceText="@CaseSummarySource" />
    </section>

    <section class="textbox-demo-panel">
        <h3>21) Case Workflow Board (BuzzKanbanBoard)</h3>
        <p>Track case items across workflow lanes and move cards with custom-labeled actions or drag-and-drop.</p>
        <BuzzKanbanBoard
            Label="Support Workflow Lanes"
            Columns="@_kanbanColumns"
            Items="@_kanbanItems"
            ItemsChanged="OnKanbanItemsChanged"
            OnItemMoved="OnKanbanItemMoved"
            ShowCounts="true"
            AllowMoveButtons="true"
            MoveLeftButtonText="Move backward"
            MoveRightButtonText="Move forward"
            EnableDragAndDrop="true"
            EnableAiRecommendedColumn="true"
            AutoRecommendOnLoad="true"
            ShowRecommendationHint="true"
            SourceText="@CaseSummarySource" />
    </section>

    <section class="textbox-demo-panel">
        <h3>22) Action Controls (BuzzButton)</h3>
        <BuzzStack Direction="horizontal" Gap="0.5rem" Wrap="true">
            <BuzzButton Text="Primary Action" Variant="primary" OnClick="OnPrimaryButtonClick" />
            <BuzzButton Text="Secondary Action" Variant="secondary" />
            <BuzzButton Text="Danger Action" Variant="danger" />
            <BuzzButton Text="Loading..." Variant="outline" Loading="true" />
        </BuzzStack>
    </section>

    <section class="textbox-demo-panel">
        <h3>23) Status Pills (BuzzBadge)</h3>
        <BuzzStack Direction="horizontal" Gap="0.45rem" Wrap="true">
            <BuzzBadge Text="Open" Variant="info" />
            <BuzzBadge Text="Resolved" Variant="success" />
            <BuzzBadge Text="Needs Review" Variant="warning" />
            <BuzzBadge Text="Blocked" Variant="danger" />
        </BuzzStack>
    </section>

    <section class="textbox-demo-panel">
        <h3>24) Content Separation (BuzzDivider)</h3>
        <p>Use divider lines to separate sections with subtle or strong visual weight.</p>
        <BuzzDivider Variant="default" />
        <BuzzDivider Variant="strong" />
    </section>

    <section class="textbox-demo-panel">
        <h3>25) Flexible Layout (BuzzStack)</h3>
        <BuzzStack Direction="horizontal" Gap="0.5rem" Wrap="true" Align="center">
            <BuzzBadge Text="Stack item A" Variant="neutral" />
            <BuzzBadge Text="Stack item B" Variant="neutral" />
            <BuzzBadge Text="Stack item C" Variant="neutral" />
        </BuzzStack>
    </section>

    <section class="textbox-demo-panel">
        <h3>26) Inline Alerts (BuzzAlert)</h3>
        <BuzzAlert
            Title="Case needs manual verification"
            Message="Automatic checks found conflicting identity signals. Please verify with the user."
            Variant="warning"
            Dismissible="true"
            @bind-IsVisible="_isAlertVisible" />
        <BuzzStack Direction="horizontal" Gap="0.5rem">
            <BuzzButton Text="Show Alert Again" Variant="secondary" OnClick="ShowAlertAgain" />
        </BuzzStack>
    </section>

    <section class="textbox-demo-panel">
        <h3>27) Identity Avatars (BuzzAvatar)</h3>
        <BuzzStack Direction="horizontal" Gap="0.6rem" Wrap="true" Align="center">
            <BuzzAvatar Name="Case Owner" Variant="accent" ShowStatusDot="true" Status="online" />
            <BuzzAvatar Name="Security Reviewer" Variant="neutral" ShowStatusDot="true" Status="busy" />
            <BuzzAvatar Name="Audit" Size="sm" Shape="rounded" />
        </BuzzStack>
    </section>

    <section class="textbox-demo-panel">
        <h3>28) Completion Indicator (BuzzProgress)</h3>
        <BuzzProgress Label="Form completion" Value="@_progressValue" Max="100" Variant="accent" ShowValueLabel="true" />
        <BuzzStack Direction="horizontal" Gap="0.5rem">
            <BuzzButton Text="Increase +10%" Variant="outline" OnClick="IncreaseProgress" />
            <BuzzButton Text="Reset" Variant="secondary" OnClick="ResetProgress" />
        </BuzzStack>
    </section>

    <section class="textbox-demo-panel">
        <h3>29) Loading Placeholders (BuzzSkeleton)</h3>
        <BuzzStack Direction="vertical" Gap="0.35rem">
            <BuzzSkeleton Variant="text" Width="65%" Height="0.9rem" />
            <BuzzSkeleton Variant="text" Width="90%" Height="0.9rem" />
            <BuzzSkeleton Variant="rect" Width="100%" Height="4rem" Radius="10px" />
        </BuzzStack>
    </section>

    <section class="textbox-demo-panel">
        <h3>30) Filter Tags (BuzzChip)</h3>
        <BuzzStack Direction="horizontal" Gap="0.35rem" Wrap="true">
            @foreach (var chip in _activeChips)
            {
                <BuzzChip Text="@chip" Variant="accent" Removable="true" OnRemove="() => RemoveChip(chip)" />
            }
        </BuzzStack>
    </section>

    <section class="textbox-demo-panel">
        <h3>31) Snapshot Metrics (BuzzStatCard)</h3>
        <BuzzStack Direction="horizontal" Gap="0.6rem" Wrap="true">
            <BuzzStatCard Label="Open Cases" Value="12" TrendText="+2 today" Description="Cases awaiting final review." Variant="warning" />
            <BuzzStatCard Label="Auto-Resolved" Value="84%" TrendText="+4.1%" Description="Resolution success this week." Variant="success" />
            <BuzzStatCard Label="Avg Handle Time" Value="34m" TrendText="-6m" Description="Mean duration per case." Variant="accent" />
        </BuzzStack>
    </section>

    <section class="textbox-demo-panel">
        <h3>32) Empty View Prompt (BuzzEmptyState)</h3>
        <BuzzEmptyState
            Title="No escalated items"
            Description="There are no P1/P2 escalations in this queue. Create one to start tracking."
            Icon="!"
            PrimaryActionText="Create escalation"
            PrimaryAction="OnCreateEscalation" />
    </section>

    <section class="textbox-demo-panel">
        <h3>33) Guided Checklist (BuzzList)</h3>
        <BuzzList Items="@_checklistItems" Ordered="true" Selectable="true" OnItemSelected="OnChecklistItemSelected" />
        <p><strong>Selected checklist step:</strong> @_selectedChecklistItem</p>
    </section>

    <section class="textbox-demo-panel">
        <h3>34) Navigation Trail (BuzzBreadcrumb)</h3>
        <BuzzBreadcrumb
            Items="@_breadcrumbItems"
            ShowHome="true"
            HomeText="Dashboard"
            Selectable="true"
            OnItemSelected="OnBreadcrumbSelected" />
        <p><strong>Selected breadcrumb:</strong> @_selectedBreadcrumb</p>
    </section>

    <section class="textbox-demo-panel">
        <h3>35) Data Pagination (BuzzPagination)</h3>
        <BuzzPagination CurrentPage="@_currentPage" CurrentPageChanged="OnPageChanged" TotalPages="12" MaxVisiblePages="5" ShowEdgeButtons="true" />
        <p><strong>Current page:</strong> @_currentPage</p>
    </section>

    <section class="textbox-demo-panel">
        <h3>36) Analytics Snapshot (BuzzDataPanel)</h3>
        <BuzzDataPanel
            Title="Incident Resolution Throughput"
            Subtitle="Last 24 hours"
            PrimaryValue="84%"
            Description="Auto-resolution rate improved after token refresh fix deployment."
            BadgeText="Stable"
            Variant="success">
            <BuzzStack Direction="horizontal" Gap="0.45rem" Wrap="true">
                <BuzzBadge Text="Resolved: 126" Variant="success" />
                <BuzzBadge Text="Escalated: 14" Variant="warning" />
            </BuzzStack>
        </BuzzDataPanel>
    </section>

    <section class="textbox-demo-panel">
        <h3>37) Outcome Banner (BuzzResultBanner)</h3>
        <BuzzResultBanner
            Title="Batch update completed"
            Message="11 records updated successfully. 1 record requires manual follow-up."
            Variant="warning"
            ActionText="Review flagged item"
            Dismissible="true"
            @bind-IsVisible="_isResultBannerVisible"
            OnAction="OnResultBannerAction" />
        <BuzzButton Text="Show Banner Again" Variant="secondary" OnClick="ShowResultBannerAgain" />
    </section>

    <section class="textbox-demo-panel">
        <h3>38) Readable Snippets (BuzzCodeBlock)</h3>
        <BuzzCodeBlock
            Title="Create a reusable card"
            Language="razor"
            Code="@_sampleCodeSnippet"
            ShowLineNumbers="true"
            WrapLines="true"
            MaxHeight="260px"
            EnableCopyButton="true" />
    </section>

    <section class="textbox-demo-panel">
        <h3>39) AI Code Workspace (BuzzCodeEditor)</h3>
        <BuzzCodeEditor
            Label="Resolution helper function"
            Language="csharp"
            @bind-Value="_codeDraft"
            Height="220px"
            EnableAiAssist="true"
            SourceContext="@CaseSummarySource" />
    </section>

    <section class="textbox-demo-panel">
        <h3>40) Action Menu (BuzzDropdownMenu)</h3>
        <BuzzDropdownMenu Label="Case actions" Items="@_demoMenuItems" OnItemSelected="OnDemoMenuSelected" />
        <p><strong>Selected menu action:</strong> @_selectedMenuAction</p>
    </section>

    <section class="textbox-demo-panel">
        <h3>41) Upload Intake (BuzzFileUpload)</h3>
        <BuzzFileUpload
            Label="Attach case evidence files"
            AllowMultiple="true"
            MaxFiles="5"
            MaxFileSizeMb="8"
            EnableAiInsight="true"
            SourceContext="@CaseSummarySource"
            FilesChanged="OnUploadedFilesChanged" />
        <p><strong>Uploaded file count:</strong> @_uploadedFiles.Count</p>
    </section>

    <section class="textbox-demo-panel">
        <h3>42) Date Window Selector (BuzzDateRangePicker)</h3>
        <BuzzDateRangePicker
            Label="Review date range"
            Start="@_rangeStart"
            StartChanged="OnRangeStartChanged"
            End="@_rangeEnd"
            EndChanged="OnRangeEndChanged"
            RangeChanged="OnRangeChanged"
            EnableAiRecommendedRange="true"
            SourceContext="@CaseSummarySource" />
        <p><strong>Range:</strong> @_rangeStart to @_rangeEnd</p>
    </section>

    <section class="textbox-demo-panel">
        <h3>43) Product Footer (BuzzFooter)</h3>
        <BuzzFooter
            BrandText="BuzzBlazor"
            Description="AI-ready UI components for support and productivity workflows."
            Links="@_footerDemoLinks"
            Copyright="@($"Copyright {DateTime.UtcNow.Year} BuzzBlazor Demo")" />
    </section>

    <section class="textbox-demo-panel">
        <h3>44) Sidebar Navigation (BuzzSideNav)</h3>
        <BuzzSideNav Title="Demo Sections" Links="@_footerDemoLinks" />
    </section>

    <section class="textbox-demo-panel">
        <h3>45) Slide-out Drawer (BuzzDrawer)</h3>
        <BuzzButton Text="Open Drawer" Variant="secondary" OnClick="OpenDrawer" />
        <BuzzDrawer @bind-IsOpen="_isDrawerOpen" Title="Case Inspector" Position="right">
            <ChildContent>
                <p>Use the drawer for contextual details, logs, or edits without leaving the page.</p>
                <BuzzBadge Text="Context Active" Variant="info" />
            </ChildContent>
            <Actions>
                <BuzzButton Text="Close Drawer" Variant="primary" OnClick="CloseDrawer" />
            </Actions>
        </BuzzDrawer>
    </section>

    <section class="textbox-demo-panel">
        <h3>46) Confirmation Prompt (BuzzConfirmDialog)</h3>
        <BuzzButton Text="Open Confirm Dialog" Variant="danger" OnClick="OpenConfirmDialog" />
        <BuzzConfirmDialog
            @bind-IsOpen="_isConfirmOpen"
            Title="Delete draft?"
            Message="This action permanently removes the current draft. Continue?"
            ConfirmButtonText="Delete draft"
            CancelButtonText="Keep draft"
            ConfirmVariant="danger"
            OnConfirm="OnConfirmDeleteDraft"
            OnCancel="OnCancelDeleteDraft" />
    </section>

    <section class="textbox-demo-panel">
        <h3>47) Toast Hub (BuzzToastCenter)</h3>
        <BuzzStack Direction="horizontal" Gap="0.35rem" Wrap="true">
            <BuzzButton Text="Add Success Toast" Variant="primary" OnClick="AddSuccessToast" />
            <BuzzButton Text="Add AI Explain Toast" Variant="outline" OnClick="AddAiToast" />
        </BuzzStack>
        <BuzzToastCenter Items="@_toastCenterItems" ItemsChanged="OnToastCenterItemsChanged" />
    </section>

    <section class="textbox-demo-panel">
        <h3>48) Marketing Hero (BuzzHero)</h3>
        <BuzzHero
            Badge="2026-ready design system"
            Title="Ship support portals and productivity apps faster"
            Subtitle="Compose accessible and AI-assisted workflows with reusable Buzz components."
            PrimaryCtaText="Start building"
            SecondaryCtaText="Read docs"
            EnableAiTagline="true"
            SourceContext="@CaseSummarySource"
            OnPrimaryCta="OnHeroPrimaryCta"
            OnSecondaryCta="OnHeroSecondaryCta" />
    </section>

    <section class="textbox-demo-panel">
        <h3>49) Pricing Layout (BuzzPricingTable)</h3>
        <BuzzPricingTable Plans="@_pricingPlans" OnPlanSelected="OnPricingPlanSelected" />
        <p><strong>Selected plan:</strong> @_selectedPricingPlan</p>
    </section>

    <section class="textbox-demo-panel">
        <h3>50) Feature Carousel (BuzzCarousel)</h3>
        <BuzzCarousel Slides="@_carouselSlides" ActiveIndexChanged="OnCarouselIndexChanged" />

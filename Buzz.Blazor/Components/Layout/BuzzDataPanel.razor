<section class="buzz-data-panel buzz-data-panel-@NormalizeVariant(Variant)">
    <header class="buzz-data-panel-header">
        <div>
            <h4 class="buzz-data-panel-title">@Title</h4>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <p class="buzz-data-panel-subtitle">@Subtitle</p>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(BadgeText))
        {
            <BuzzBadge Text="@BadgeText" Variant="info" />
        }
    </header>

    @if (!string.IsNullOrWhiteSpace(PrimaryValue))
    {
        <p class="buzz-data-panel-value">@PrimaryValue</p>
    }

    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p class="buzz-data-panel-description">@Description</p>
    }

    @ChildContent
</section>

@code {
    /// <summary>
    /// Panel title text.
    /// </summary>
    [Parameter]
    public string Title { get; set; } = "Data panel";

    /// <summary>
    /// Optional panel subtitle.
    /// </summary>
    [Parameter]
    public string Subtitle { get; set; } = string.Empty;

    /// <summary>
    /// Primary metric value shown in the panel.
    /// </summary>
    [Parameter]
    public string PrimaryValue { get; set; } = string.Empty;

    /// <summary>
    /// Supporting descriptive text.
    /// </summary>
    [Parameter]
    public string Description { get; set; } = string.Empty;

    /// <summary>
    /// Optional badge label.
    /// </summary>
    [Parameter]
    public string BadgeText { get; set; } = string.Empty;

    /// <summary>
    /// Visual variant (neutral, accent, success, warning).
    /// </summary>
    [Parameter]
    public string Variant { get; set; } = "neutral";

    /// <summary>
    /// Optional extra body content.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private static string NormalizeVariant(string? value) =>
        value?.Trim().ToLowerInvariant() switch
        {
            "accent" => "accent",
            "success" => "success",
            "warning" => "warning",
            _ => "neutral"
        };
}

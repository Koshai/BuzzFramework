@using Buzz.Blazor.Models
@using Buzz.Core
@using Microsoft.Extensions.Logging
@inject IBuzzClient BuzzClient
@inject ILogger<BuzzCommandPalette> Logger

<div class="buzz-command-palette">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <h3 class="buzz-command-label">@Label</h3>
    }

    <input
        class="buzz-command-input"
        type="text"
        value="@_query"
        placeholder="@Placeholder"
        @oninput="HandleQueryInputAsync" />

    @if (ShowRecommendationHint && !string.IsNullOrWhiteSpace(_recommendedCommand))
    {
        <p class="buzz-command-recommendation">
            Recommended command: <strong>@_recommendedCommand</strong>
        </p>
    }

    @if (!string.IsNullOrWhiteSpace(_selectedCommand))
    {
        <p class="buzz-command-selected">
            Selected command: <strong>@_selectedCommand</strong>
        </p>
    }

    @if (VisibleCommands.Count == 0)
    {
        <p class="buzz-command-empty">No command matches your search.</p>
    }
    else
    {
        <ul class="buzz-command-list">
            @foreach (var item in VisibleCommands)
            {
                <li class="buzz-command-item">
                    <button type="button" class="buzz-command-button" @onclick="() => SelectCommandAsync(item)">
                        <span class="buzz-command-title">@item.Title</span>
                        <span class="buzz-command-description">@item.Description</span>
                    </button>
                </li>
            }
        </ul>
    }
</div>

@code {
    /// <summary>
    /// Command palette heading label.
    /// </summary>
    [Parameter]
    public string Label { get; set; } = "Buzz Command Palette";

    /// <summary>
    /// Query input placeholder text.
    /// </summary>
    [Parameter]
    public string Placeholder { get; set; } = "Search commands...";

    /// <summary>
    /// Available command entries.
    /// </summary>
    [Parameter]
    public IReadOnlyList<BuzzCommandItem> Commands { get; set; } = [];

    /// <summary>
    /// Current query text value.
    /// </summary>
    [Parameter]
    public string Query { get; set; } = string.Empty;

    /// <summary>
    /// Two-way binding callback for <see cref="Query"/>.
    /// </summary>
    [Parameter]
    public EventCallback<string> QueryChanged { get; set; }

    /// <summary>
    /// Selected command title value.
    /// </summary>
    [Parameter]
    public string SelectedCommand { get; set; } = string.Empty;

    /// <summary>
    /// Two-way binding callback for <see cref="SelectedCommand"/>.
    /// </summary>
    [Parameter]
    public EventCallback<string> SelectedCommandChanged { get; set; }

    /// <summary>
    /// Updates query text to selected command title.
    /// </summary>
    [Parameter]
    public bool SyncQueryWithSelection { get; set; } = true;

    /// <summary>
    /// Maximum visible commands in the filtered list.
    /// </summary>
    [Parameter]
    public int MaxVisibleCommands { get; set; } = 8;

    /// <summary>
    /// Shows AI recommendation hint text.
    /// </summary>
    [Parameter]
    public bool ShowRecommendationHint { get; set; } = true;

    /// <summary>
    /// Enables AI command recommendation.
    /// </summary>
    [Parameter]
    public bool EnableAiRecommendedCommand { get; set; } = true;

    /// <summary>
    /// Automatically requests recommendation on load.
    /// </summary>
    [Parameter]
    public bool AutoRecommendOnLoad { get; set; } = true;

    /// <summary>
    /// Context text sent to AI recommendation.
    /// </summary>
    [Parameter]
    public string SourceText { get; set; } = string.Empty;

    /// <summary>
    /// Maximum context characters sent to AI.
    /// </summary>
    [Parameter]
    public int MaxInputCharacters { get; set; } = 1200;

    private string _query = string.Empty;
    private string _selectedCommand = string.Empty;
    private string? _recommendedCommand;
    private bool _recommendationLoaded;

    private IReadOnlyList<BuzzCommandItem> VisibleCommands =>
        FilterCommands(Commands, _query).Take(Math.Max(1, MaxVisibleCommands)).ToList();

    protected override async Task OnParametersSetAsync()
    {
        _query = Query ?? string.Empty;
        _selectedCommand = SelectedCommand ?? string.Empty;

        if (!EnableAiRecommendedCommand || !AutoRecommendOnLoad || _recommendationLoaded || Commands.Count == 0)
        {
            return;
        }

        await TryLoadRecommendationAsync();
        _recommendationLoaded = true;
    }

    private async Task HandleQueryInputAsync(ChangeEventArgs args)
    {
        _query = args.Value?.ToString() ?? string.Empty;
        await QueryChanged.InvokeAsync(_query);
    }

    private async Task SelectCommandAsync(BuzzCommandItem item)
    {
        _selectedCommand = item.Title;
        await SelectedCommandChanged.InvokeAsync(item.Value);

        if (!SyncQueryWithSelection)
        {
            return;
        }

        _query = item.Title;
        await QueryChanged.InvokeAsync(_query);
    }

    private static IEnumerable<BuzzCommandItem> FilterCommands(IEnumerable<BuzzCommandItem> commands, string query)
    {
        if (string.IsNullOrWhiteSpace(query))
        {
            return commands;
        }

        var text = query.Trim();
        return commands.Where(item =>
            item.Title.Contains(text, StringComparison.OrdinalIgnoreCase) ||
            item.Description.Contains(text, StringComparison.OrdinalIgnoreCase) ||
            item.Value.Contains(text, StringComparison.OrdinalIgnoreCase));
    }

    private async Task TryLoadRecommendationAsync()
    {
        var source = (SourceText ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(source))
        {
            return;
        }

        var constrainedInput = source.Length > MaxInputCharacters
            ? source[..MaxInputCharacters]
            : source;
        var titles = Commands
            .Select(item => item.Title.Trim())
            .Where(item => item.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (titles.Count == 0)
        {
            return;
        }

        try
        {
            var response = await BuzzClient.GenerateAsync(
                new BuzzRequest(
                    constrainedInput,
                    "Choose exactly one command title from the provided list that should be suggested first. Return only the command title text and nothing else.",
                    $"CommandTitles: {string.Join(" | ", titles)}"));

            var candidate = (response.OutputText ?? string.Empty).Trim();
            var match = titles.FirstOrDefault(title => title.Equals(candidate, StringComparison.OrdinalIgnoreCase))
                ?? titles.FirstOrDefault(title => candidate.Contains(title, StringComparison.OrdinalIgnoreCase));
            if (string.IsNullOrWhiteSpace(match))
            {
                return;
            }

            _recommendedCommand = match;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "BuzzCommandPalette recommendation generation failed.");
        }
    }
}

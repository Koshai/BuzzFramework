@page "/demo"
@rendermode InteractiveServer

<PageTitle>Demo Hub</PageTitle>

<h1>Buzz Demo Hub</h1>
<p>Use these focused pages instead of one long demo screen.</p>

<DemoAiContextBanner SampleText="@_sampleText" />

<section class="demo-hub-grid">
    @foreach (var item in _demoPages)
    {
        <article class="demo-hub-card">
            <h2>@item.Title</h2>
            <p>@item.Description</p>
            <a class="demo-hub-link" href="@item.Href">Open page</a>
        </article>
    }
</section>

@code {
    private readonly string _sampleText =
        "Customer issue: Login intermittently fails for SSO users in APAC after password reset.\n" +
        "Observed impact: 6.2% failed login attempts in the last 24h.\n" +
        "Requested outcome: concise root-cause hypotheses and a next-step plan.";

    private readonly IReadOnlyList<DemoPageLink> _demoPages =
    [
        new("Inputs", "Text, select, date, and AI-assisted field suggestions.", "/demo-inputs"),
        new("Feedback", "Alerts, banners, toasts, and card-level AI summaries.", "/demo-feedback"),
        new("Workflow", "Command palette, date ranges, and smart table analysis.", "/demo-workflow"),
        new("Marketing", "Hero, pricing, carousel, and auth shell examples.", "/demo-marketing"),
        new("Legacy Full Demo", "Original all-in-one page for deep reference.", "/textbox-demo")
    ];

    private sealed record DemoPageLink(string Title, string Description, string Href);
}

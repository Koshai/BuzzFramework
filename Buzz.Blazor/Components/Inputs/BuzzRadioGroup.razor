@using Buzz.Blazor.Models
@using Buzz.Blazor.Services
@using Microsoft.Extensions.Logging
@inject IBuzzOptionRanker OptionRanker
@inject NavigationManager NavigationManager
@inject ILogger<BuzzRadioGroup> Logger

<div class="buzz-radio-group">
    <fieldset
        class="buzz-radio-group-fieldset"
        disabled="@Disabled"
        aria-required="@Required"
        aria-invalid="@HasErrorText"
        aria-describedby="@ResolvedDescribedBy">
        <legend class="buzz-radio-group-legend">@Label</legend>

        @for (var i = 0; i < _rankedOptions.Count; i++)
        {
            var option = _rankedOptions[i];
            var optionId = BuildOptionId(i);
            <label class="buzz-radio-option" for="@optionId">
                <input
                    id="@optionId"
                    class="buzz-radio-option-input"
                    type="radio"
                    name="@_groupName"
                    value="@option.Value"
                    checked="@IsSelected(option.Value)"
                    required="@Required"
                    @onchange="HandleChangedAsync" />
                <span class="buzz-radio-option-text">@option.Value</span>
                @if (ShowRankingReasons && !string.IsNullOrWhiteSpace(option.Reason))
                {
                    <span class="buzz-radio-option-reason">(@option.Reason)</span>
                }
            </label>
        }
    </fieldset>

    @if (ShowRecommendationHint && _recommendedOption is not null)
    {
        <p id="@_recommendationId" class="buzz-radio-recommendation">
            Recommended: <strong>@_recommendedOption.Value</strong>
            @if (!string.IsNullOrWhiteSpace(_recommendedOption.Reason))
            {
                <span class="buzz-radio-recommendation-reason">(@_recommendedOption.Reason)</span>
            }
        </p>
    }

    @if (!string.IsNullOrWhiteSpace(HelperText))
    {
        <p id="@_helperTextId" class="buzz-radio-helper">@HelperText</p>
    }

    @if (HasErrorText)
    {
        <p id="@_errorTextId" class="buzz-radio-error">@ErrorText</p>
    }
</div>

@code {
    /// <summary>
    /// Fieldset legend label.
    /// </summary>
    [Parameter]
    public string Label { get; set; } = "Buzz Radio Group";

    /// <summary>
    /// Radio option values.
    /// </summary>
    [Parameter]
    public IReadOnlyList<string> Options { get; set; } = [];

    /// <summary>
    /// Currently selected option value.
    /// </summary>
    [Parameter]
    public string Value { get; set; } = string.Empty;

    /// <summary>
    /// Two-way binding callback for <see cref="Value"/>.
    /// </summary>
    [Parameter]
    public EventCallback<string> ValueChanged { get; set; }

    /// <summary>
    /// Disables all radio options.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Marks radio group as required.
    /// </summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>
    /// Maximum ranked options to show.
    /// </summary>
    [Parameter]
    public int MaxVisibleOptions { get; set; } = 8;

    /// <summary>
    /// Optional memory topic key for ranking context.
    /// </summary>
    [Parameter]
    public string? MemorySubject { get; set; }

    /// <summary>
    /// Optional reference context used for ranking.
    /// </summary>
    [Parameter]
    public string? ReferenceText { get; set; }

    /// <summary>
    /// Shows top recommendation hint text.
    /// </summary>
    [Parameter]
    public bool ShowRecommendationHint { get; set; } = true;

    /// <summary>
    /// Shows ranking reason text for each option.
    /// </summary>
    [Parameter]
    public bool ShowRankingReasons { get; set; } = true;

    /// <summary>
    /// Optional helper text under the group.
    /// </summary>
    [Parameter]
    public string? HelperText { get; set; }

    /// <summary>
    /// Optional error text under the group.
    /// </summary>
    [Parameter]
    public string? ErrorText { get; set; }

    /// <summary>
    /// Additional aria-describedby id(s) to append.
    /// </summary>
    [Parameter]
    public string? DescribedBy { get; set; }

    private readonly string _groupName = $"buzz-radio-{Guid.NewGuid():N}";
    private readonly string _helperTextId = $"buzz-radio-helper-{Guid.NewGuid():N}";
    private readonly string _errorTextId = $"buzz-radio-error-{Guid.NewGuid():N}";
    private readonly string _recommendationId = $"buzz-radio-recommendation-{Guid.NewGuid():N}";
    private readonly List<BuzzRankedOption> _rankedOptions = [];
    private BuzzRankedOption? _recommendedOption;
    private bool HasErrorText => !string.IsNullOrWhiteSpace(ErrorText);

    private string? ResolvedDescribedBy
    {
        get
        {
            var ids = new List<string>();
            if (!string.IsNullOrWhiteSpace(DescribedBy))
            {
                ids.Add(DescribedBy.Trim());
            }

            if (ShowRecommendationHint && _recommendedOption is not null)
            {
                ids.Add(_recommendationId);
            }

            if (!string.IsNullOrWhiteSpace(HelperText))
            {
                ids.Add(_helperTextId);
            }

            if (HasErrorText)
            {
                ids.Add(_errorTextId);
            }

            return ids.Count == 0 ? null : string.Join(" ", ids);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await RefreshRankedOptionsAsync();
    }

    private bool IsSelected(string option) =>
        option.Equals(Value, StringComparison.OrdinalIgnoreCase);

    private async Task HandleChangedAsync(ChangeEventArgs args)
    {
        var selected = args.Value?.ToString() ?? string.Empty;
        await ValueChanged.InvokeAsync(selected);

        if (!string.IsNullOrWhiteSpace(selected))
        {
            await OptionRanker.RememberSelectionAsync(
                selected,
                Label,
                CurrentPagePath(),
                MemorySubject,
                ReferenceText);
        }
    }

    private async Task RefreshRankedOptionsAsync()
    {
        _rankedOptions.Clear();
        if (Options.Count == 0)
        {
            _recommendedOption = null;
            return;
        }

        try
        {
            var ranked = await OptionRanker.RankAsync(
                Options,
                Value,
                Label,
                CurrentPagePath(),
                MemorySubject,
                ReferenceText,
                MaxVisibleOptions);

            if (!string.IsNullOrWhiteSpace(Value) &&
                ranked.All(option => !option.Value.Equals(Value, StringComparison.OrdinalIgnoreCase)))
            {
                _rankedOptions.Add(new BuzzRankedOption(Value, "Current selection"));
            }

            _rankedOptions.AddRange(ranked);
        }
        catch (Exception ex)
        {
            // Keep baseline radio behavior even if ranking fails.
            Logger.LogWarning(ex, "BuzzRadioGroup ranking failed. Falling back to plain options.");

            _rankedOptions.AddRange(Options
                .Where(option => !string.IsNullOrWhiteSpace(option))
                .Select(option => option.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Take(Math.Max(MaxVisibleOptions, 1))
                .Select(option => new BuzzRankedOption(option, null)));

            if (!string.IsNullOrWhiteSpace(Value) &&
                _rankedOptions.All(option => !option.Value.Equals(Value, StringComparison.OrdinalIgnoreCase)))
            {
                _rankedOptions.Insert(0, new BuzzRankedOption(Value, "Current selection"));
            }
        }

        _recommendedOption = _rankedOptions.FirstOrDefault();
    }

    private string CurrentPagePath()
    {
        var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        return string.IsNullOrWhiteSpace(relative) ? "/" : $"/{relative}";
    }

    private string BuildOptionId(int index) => $"{_groupName}-option-{index}";
}

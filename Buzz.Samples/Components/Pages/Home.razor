@page "/"
@rendermode InteractiveServer
@using Buzz.Blazor.Models
@inject NavigationManager Navigation

<PageTitle>BuzzBlazor</PageTitle>

<div class="home-page">
    <BuzzHero Badge="BuzzBlazor 2026"
              Title="Build modern Blazor products with a single, AI-ready design system"
              Subtitle="A component-first framework for production UIs: consistent APIs, accessible defaults, five themes, and practical AI assistance."
              PrimaryCtaText="Start Building"
              SecondaryCtaText="Explore Components"
              OnPrimaryCta="OpenGettingStarted"
              OnSecondaryCta="OpenDemoHub"
              EnableAiTagline="true"
              SourceContext="@_heroSource" />

    <section class="home-proof-strip">
        <BuzzBadge Text="Native Blazor Components" Variant="info" />
        <BuzzBadge Text="Accessibility-First Defaults" Variant="success" />
        <BuzzBadge Text="5 Production Themes" Variant="warning" />
        <BuzzBadge Text="Seed + Live AI Context" Variant="danger" />
    </section>

    <section class="home-metrics-grid buzz-animate-slide-up">
        <BuzzStatCard Label="Reusable Components" Value="50+" TrendText="Growing" Description="Inputs, feedback, data, layout, and workflow blocks." Variant="accent" />
        <BuzzStatCard Label="Theme Sets" Value="5" TrendText="System-wide" Description="Azure, Emerald, Violet, Coral, and Slate palettes." Variant="success" />
        <BuzzStatCard Label="Guided Demo Pages" Value="6" TrendText="Focused" Description="Category pages to evaluate behavior quickly." Variant="warning" />
        <BuzzStatCard Label="In-App Docs" Value="1" TrendText="Always available" Description="Comprehensive guide with usage snippets." Variant="neutral" />
    </section>

    <section class="home-panel buzz-animate-scale-in">
        <h2>Framework Experience</h2>
        <p>Buzz.Samples now behaves like a component library website: quick onboarding, production references, and guided implementation paths.</p>
        <div class="home-feature-grid">
            @foreach (var feature in _frameworkFeatures)
            {
                <BuzzCard Title="@feature.Title" Subtitle="@feature.Subtitle" EnableAiSummary="false">
                    <BuzzStack Direction="horizontal" Gap="0.4rem" Wrap="true" Align="center">
                        <BuzzBadge Text="@feature.Tag" Variant="info" />
                        <BuzzButton Text="Open" Variant="outline" Size="sm" OnClick="() => OpenRoute(feature.Path)" />
                    </BuzzStack>
                </BuzzCard>
            }
        </div>
    </section>

    <section class="home-showcase-grid buzz-animate-fade-in">
        <article class="home-panel">
            <h2>Why Teams Choose Buzz</h2>
            <BuzzList Items="@_valuePropositionPoints" Ordered="false" />
        </article>
        <article class="home-panel">
            <h2>AI Model in Practice</h2>
            <BuzzList Items="@_aiModelPoints" Ordered="false" />
            <BuzzCodeBlock Code="@_aiPatternSnippet" Language="text" ShowLineNumbers="false" EnableCopyButton="true" />
        </article>
    </section>

    <section class="home-panel-grid buzz-animate-slide-up">
        <section class="home-panel">
            <h2>Recommended Evaluation Flow</h2>
            <BuzzList Items="@_recommendedDemoFlow" Ordered="true" />
        </section>
        <section class="home-panel">
            <h2>Quick Start Commands</h2>
            <BuzzCodeBlock Code="@_quickInstallSnippet" Language="bash" ShowLineNumbers="false" EnableCopyButton="true" />
            <p class="home-muted">Use local packages from <code>BuzzLocal</code> for isolated validation in new apps.</p>
        </section>
    </section>

    <section class="home-pricing-block">
        <div class="home-pricing-header">
            <h2>Adoption Paths</h2>
            <p>Move from trial to production with clear checkpoints.</p>
        </div>
        <BuzzPricingTable Plans="@_adoptionPlans" OnPlanSelected="OnPlanSelectedAsync" />
        @if (!string.IsNullOrWhiteSpace(_selectedPlan))
        {
            <p class="home-muted">Selected path: <strong>@_selectedPlan</strong></p>
        }
    </section>

    <section class="home-panel">
        <h2>Frequently Asked Questions</h2>
        <BuzzAccordion Label="Framework FAQ"
                       Sections="@_faqSections"
                       AllowMultipleOpen="false"
                       ShowRecommendationHint="false"
                       EnableAiRecommendedSection="true"
                       SourceText="@_heroSource" />
    </section>

    <section class="home-cta-strip">
        <article class="home-cta-content">
            <h2>Ready to ship your first BuzzBlazor-based product page?</h2>
            <p>Start with Getting Started, validate in Components, then follow the beginner Medical Triage tutorial end-to-end.</p>
            <BuzzStack Direction="horizontal" Gap="0.5rem" Wrap="true" Align="center">
                <BuzzButton Text="Getting Started" Variant="primary" OnClick="OpenGettingStarted" />
                <BuzzButton Text="Medical Tutorial" Variant="outline" OnClick="OpenMedicalTutorial" />
                <BuzzButton Text="Developer Guide" Variant="secondary" OnClick="OpenGuide" />
            </BuzzStack>
        </article>
    </section>
</div>

@code {
    private readonly string _heroSource =
        "Audience: product engineering teams evaluating modern Blazor component systems.\n" +
        "Priorities: high consistency, accessibility, theme flexibility, and practical AI assistance from day one.";

    private readonly IReadOnlyList<FrameworkFeatureItem> _frameworkFeatures =
    [
        new("Component Library", "Evaluate categorized components and behavior-specific demos.", "Components", "/demo"),
        new("Developer Guide", "Read parameter-level references and copy-ready snippets.", "Documentation", "/developer-guide"),
        new("Medical Triage Tutorial", "Beginner walkthrough with complete code at the final step.", "Tutorial", "/tutorial-medical"),
        new("Installation", "Set up package references, providers, and AI context bootstrap.", "Setup", "/installation")
    ];

    private readonly IReadOnlyList<string> _valuePropositionPoints =
    [
        "Single design language across demos, docs, and production components.",
        "Consistent APIs across inputs, workflows, and data-heavy components.",
        "Built-in support for accessible interaction and keyboard-first navigation.",
        "Five curated themes applied globally with one selector."
    ];

    private readonly IReadOnlyList<string> _aiModelPoints =
    [
        "Seed knowledge provides useful first-run suggestions at deployment time.",
        "Live user memory improves relevance as usage data accumulates.",
        "Component context is explicit with subject keys for predictable AI behavior.",
        "Fallback text ensures UX continuity when provider calls fail."
    ];

    private readonly string _aiPatternSnippet =
        "AI context precedence:\n" +
        "1) User/session context\n" +
        "2) Developer-provided source context\n" +
        "3) Seed knowledge defaults\n" +
        "4) Component baseline behavior";

    private readonly IReadOnlyList<string> _recommendedDemoFlow =
    [
        "Open Components and review Inputs, Feedback, Workflow, and Marketing pages.",
        "Switch all five themes and confirm readability and contrast consistency.",
        "Open Developer Guide for implementation details and parameter effects.",
        "Run Medical Tutorial to complete a beginner-friendly real use case."
    ];

    private readonly string _quickInstallSnippet =
        "dotnet add package BuzzBlazor.Core --version 0.1.0-preview.3\n" +
        "dotnet add package BuzzBlazor --version 0.1.0-preview.3\n" +
        "dotnet add package BuzzBlazor.Provider.OpenAI --version 0.1.0-preview.3\n" +
        "dotnet add package BuzzBlazor.Provider.Ollama --version 0.1.0-preview.3";

    private readonly IReadOnlyList<BuzzPricingPlan> _adoptionPlans =
    [
        new("Explore", "Free", "phase", ["Use samples", "Review component behavior", "Validate accessibility"], false, "Start Exploring"),
        new("Build", "Team", "phase", ["Implement core screens", "Apply brand themes", "Enable AI context"], true, "Begin Building"),
        new("Release", "Production", "phase", ["Package with NuGet", "Harden configs", "Ship docs and examples"], false, "Prepare Release")
    ];

    private readonly IReadOnlyList<BuzzAccordionItem> _faqSections =
    [
        new("Can we use Buzz without AI?", "Yes. AI is optional and can be toggled per component and per environment.", true),
        new("Are themes global?", "Yes. Theme tokens apply to the whole site so component surfaces stay visually consistent."),
        new("Where should beginners start?", "Use Getting Started first, then follow the Medical Tutorial from Step 1 to final full code."),
        new("How should we validate before release?", "Run demos across all five themes, complete accessibility checks, and verify fallback behavior for AI-disabled scenarios.")
    ];

    private string _selectedPlan = string.Empty;

    private void OpenGettingStarted() => Navigation.NavigateTo("/getting-started");
    private void OpenInstallation() => Navigation.NavigateTo("/installation");
    private void OpenGuide() => Navigation.NavigateTo("/developer-guide");
    private void OpenMedicalTutorial() => Navigation.NavigateTo("/tutorial-medical");
    private void OpenDemoHub() => Navigation.NavigateTo("/demo");
    private Task OpenRoute(string path)
    {
        Navigation.NavigateTo(path);
        return Task.CompletedTask;
    }

    private Task OnPlanSelectedAsync(BuzzPricingPlan plan)
    {
        _selectedPlan = plan.Name;
        return Task.CompletedTask;
    }

    private sealed record FrameworkFeatureItem(string Title, string Subtitle, string Tag, string Path);
}


    private string FormAssistantRequiredCompletionText
    {
        get
        {
            var required = FormAssistantFields.Where(entry => entry.Required).ToList();
            var total = required.Count;
            var filled = required.Count(entry => !string.IsNullOrWhiteSpace(entry.Value));
            return total == 0
                ? "100% (0 / 0)"
                : $"{(int)Math.Round((filled * 100.0) / total)}% ({filled} / {total})";
        }
    }


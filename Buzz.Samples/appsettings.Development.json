{
  "Buzz": {
    "DefaultProvider": "openai",
    "ProviderFailoverOrder": [ "openai", "ollama", "mock" ],
    "EnableAiSuggestions": true,
    "AiMinInputLength": 12,
    "AiMaxLocalResultsBeforeSkip": 2,
    "AiCooldownSeconds": 10,
    "AiCacheTtlSeconds": 180,
    "AiMaxPromptCharacters": 1800,
    "AiMaxUserInputCharacters": 350,
    "AiMaxRequestsPerDay": 400,
    "AiBudgetExceededBehavior": "fallback-mock",
    "EnableSharedCaseMemory": true,
    "SharedCaseMemoryMaxEntriesPerSubject": 2000,
    "OpenAI": {
      "Model": "gpt-4o-mini",
      "MaxOutputTokens": 220,
      "Temperature": 0.2,
      "ApiKey": ""
    },
    "Ollama": {
      "BaseUrl": "http://localhost:11434/api/",
      "Model": "llama3.2:latest"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Buzz.Blazor": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}

<section class="buzz-auth-shell">
    <article class="buzz-auth-card">
        <header class="buzz-auth-header">
            <h2>@Title</h2>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <p>@Subtitle</p>
            }
        </header>

        <div class="buzz-auth-body">
            @ChildContent
        </div>

        @if (Actions is not null)
        {
            <footer class="buzz-auth-actions">
                @Actions
            </footer>
        }
    </article>
</section>

@code {
    /// <summary>
    /// Authentication card title.
    /// </summary>
    [Parameter]
    public string Title { get; set; } = "Welcome back";

    /// <summary>
    /// Authentication card subtitle.
    /// </summary>
    [Parameter]
    public string Subtitle { get; set; } = "Sign in to continue.";

    /// <summary>
    /// Main content for the auth form.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Optional action area content.
    /// </summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }
}
